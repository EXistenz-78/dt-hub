    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub reads and saves models and images in the folders you choose on the Desktop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub legge e salva modelli e immagini nelle cartelle della Scrivania che scegli."
          }
        }
      }
    },
