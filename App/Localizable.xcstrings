    "prefs.dt.connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega"
          }
        }
      }
    },
    "prefs.dt.error.emptyHost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the server address"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’indirizzo del server"
          }
        }
      }
    },
    "prefs.dt.error.invalidHost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter only a host name or IP address, without http://, paths or :port"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci solo un nome host o un indirizzo IP, senza http://, percorsi né :porta"
          }
        }
      }
    },
    "prefs.dt.error.invalidPort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port must be between 1 and 65535"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta deve essere tra 1 e 65535"
          }
        }
      }
    },
    "prefs.dt.host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo"
          }
        }
      }
    },
    "prefs.dt.models": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld models available"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld modelli disponibili"
          }
        }
      }
    },
    "prefs.dt.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub connects to a Draw Things server that is already running: the Draw Things app’s API server in gRPC mode, or gRPCServerCLI. Its API server uses TLS by default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub si collega a un server Draw Things già avviato: l’API Server dell’app Draw Things in modalità gRPC, oppure gRPCServerCLI. L’API Server usa TLS per impostazione predefinita."
          }
        }
      }
    },
    "prefs.dt.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta"
          }
        }
      }
    },
    "prefs.dt.secret": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared secret"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice di accesso (shared secret)"
          }
        }
      }
    },
