      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the generation (⌘↩)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la generazione (⌘↩)"
          }
        }
      }
