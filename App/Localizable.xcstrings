      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared secret could not be saved in the Keychain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il codice di accesso nel Portachiavi"
          }
        }
      }
    },
    "prefs.dt.tls": {
      "extractionState": "manual",
      "localizations": {
