{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DT Hub"
          }
        }
      }
    },
    "generation.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The generation parameter cards will appear here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compariranno le card dei parametri di generazione."
          }
        }
      }
    },
    "generation.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No parameters yet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun parametro"
          }
        }
      }
    },
    "header.model.browsingDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Model browsing” in the Draw Things API server settings"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva “Model browsing” nelle impostazioni dell’API Server di Draw Things"
          }
        }
      }
    },
    "header.model.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No models installed on the server"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello installato sul server"
          }
        }
      }
    },
    "header.model.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not on the server"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "non presente sul server"
          }
        }
      }
    },
