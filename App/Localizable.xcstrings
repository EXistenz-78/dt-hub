          "stringUnit": {
            "state": "translated",
            "value": "DT Hub si collega a un server Draw Things già avviato: l’API Server dell’app Draw Things in modalità gRPC, oppure gRPCServerCLI. L’API Server usa TLS per impostazione predefinita."
          }
        }
      }
    },
