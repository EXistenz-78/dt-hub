<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The rest of the Info.plist is generated by Xcode from the build settings. This file holds what a build
	     setting cannot say: a .dthubplugin is a package (the Finder shows it as one file, like an .app) with its own icon
	     (App/Resources/docicon.icns). The usage descriptions are the texts macOS shows when asking for access to external
	     disks, network disks and the Documents, Desktop and Downloads folders (translated in App/InfoPlist.xcstrings). -->
	<key>NSRemovableVolumesUsageDescription</key>
	<string>DT Hub reads and saves models and images on the external disks you choose.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>DT Hub reads and saves models and images on the network disks you choose.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>DT Hub reads and saves models and images in the folders you choose in Documents.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>DT Hub reads and saves models and images in the folders you choose on the Desktop.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>DT Hub reads and saves models and images in the folders you choose in Downloads.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.exiztenz.dthub.plugin</string>
			<key>UTTypeDescription</key>
			<string>DT Hub Plug-in</string>
			<key>UTTypeIconFile</key>
			<string>docicon</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dthubplugin</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
