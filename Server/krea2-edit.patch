+  /// Converts Ming-Image's VAE with the Wan VAE graph (RGBA on both ends): `__encoder__[...]`,
+  /// `__decoder__[...]`, as the engine reads them.
+  private func convertMingVAE() throws {
+    guard let safeTensors = SafeTensors(url: URL(fileURLWithPath: file)) else {
+      throw MingTextEncoderError.cannotOpenFile(file)
+    }
+    let states = safeTensors.states
+    let graph = DynamicGraph()
+    let fileName = Importer.cleanup(filename: name)
+    let outputPath = URL(fileURLWithPath: outputDirectory)
+      .appendingPathComponent("\(fileName)_f16.ckpt").path
+    let side = 64
+    var written = Set<String>()
+    try graph.withNoGrad {
+      let (decoderMapper, decoder) = MingVAEDecoder(width: side / 8, height: side / 8)
+      let (encoderMapper, encoder) = MingVAEEncoder(width: side / 8, height: side / 8)
+      decoder.compile(inputs: graph.variable(.GPU(0), .NHWC(1, side / 8, side / 8, 16), of: FloatType.self))
+      encoder.compile(inputs: graph.variable(.GPU(0), .NHWC(1, side, side, 4), of: FloatType.self))
+      try graph.openStore(outputPath) { store in
+        store.removeAll()
+        try store.withTransaction {
+          for (mapper, prefix) in [(decoderMapper, "__decoder__"), (encoderMapper, "__encoder__")] {
+            for (key, element) in mapper(.diffusers).sorted(by: { $0.key < $1.key }) {
+              guard let descriptor = states[key] else { throw MingTextEncoderError.missingTensor(key) }
+              written.insert(key)
+              try safeTensors.with(descriptor) { source in
+                element.write(
+                  graph: graph, to: store, tensor: Tensor<FloatType>(from: source),
+                  format: element.format, isDiagonalUp: false, isDiagonalDown: false
+                ) { "\(prefix)[\($0)]" }
+              }
+            }
+          }
+        }
+      }
+    }
+    let unused = Set(states.keys).subtracting(written)
+    print("Wrote \(outputPath): \(written.count) of \(states.count) tensors used")
+    if !unused.isEmpty {
+      print("Not used: \(unused.sorted().prefix(10))")
+    }
+  }
+
+  /// Converts Ming-Image's Qwen2.5-VL vision tower and `linear_proj` to the tensors the engine's
+  /// `Qwen2VLVisionTransformer` and `MingImageProjection` read: `__vit__[t-<module>-<block>-<n>]`.
+  /// Hugging Face rotates the two halves of each head and the engine adjacent pairs, so the query
+  /// and key rows (and biases) are reordered per head (16 heads of 80).
+  private func convertMingVision() throws {
+    guard let safeTensors = SafeTensors(url: URL(fileURLWithPath: file)) else {
+      throw MingTextEncoderError.cannotOpenFile(file)
+    }
+    let states = safeTensors.states
+    func read(_ key: String) throws -> Tensor<Float> {
+      guard let descriptor = states[key] else { throw MingTextEncoderError.missingTensor(key) }
+      return try safeTensors.with(descriptor) { Tensor<Float>(from: $0).toCPU() }
+    }
+    func interleave(_ tensor: Tensor<Float>, headDimension: Int) -> Tensor<Float> {
+      let shape = tensor.shape
+      let rows = shape[0]
+      let columns = shape.count > 1 ? shape[1] : 1
+      var result = Tensor<Float>(.CPU, format: .NCHW, shape: shape)
+      let half = headDimension / 2
+      tensor.withUnsafeBytes { source in
+        let source = source.baseAddress!.assumingMemoryBound(to: Float.self)
+        result.withUnsafeMutableBytes { destination in
+          let destination = destination.baseAddress!.assumingMemoryBound(to: Float.self)
+          for row in 0..<rows {
+            let head = row / headDimension
+            let i = row % headDimension
+            let target = head * headDimension + (i < half ? i * 2 : (i - half) * 2 + 1)
+            for column in 0..<columns {
+              destination[target * columns + column] = source[row * columns + column]
+            }
+          }
+        }
+      }
+      return result
+    }
+    func rows(_ tensor: Tensor<Float>, _ range: Range<Int>) -> Tensor<Float> {
+      let shape = tensor.shape
+      if shape.count == 1 { return tensor[range].copied() }
+      return tensor[range, 0..<shape[1]].copied()
+    }
+    let graph = DynamicGraph()
+    let fileName = Importer.cleanup(filename: name)
+    let outputPath = URL(fileURLWithPath: outputDirectory)
+      .appendingPathComponent("\(fileName)_f16.ckpt").path
+    try graph.openStore(outputPath) { store in
+      store.removeAll()
+      try store.withTransaction {
+        func write(_ name: String, _ tensor: Tensor<Float>) {
+          store.write("__vit__[\(name)]", tensor: Tensor<FloatType>(from: tensor))
+        }
+        let patch = try read("vision.patch_embed.proj.weight")
+        write(
+          "t-conv_in-0-0",
+          patch.reshaped(format: .NCHW, shape: [patch.shape[0], 3 * 2 * 14 * 14]))
+        for block in 0..<32 {
+          let prefix = "vision.blocks.\(block)"
+          let qkvWeight = try read("\(prefix).attn.qkv.weight")
+          let qkvBias = try read("\(prefix).attn.qkv.bias")
+          for (index, projection) in ["q_proj", "k_proj", "v_proj"].enumerated() {
+            var weight = rows(qkvWeight, (index * 1_280)..<((index + 1) * 1_280))
+            var bias = rows(qkvBias, (index * 1_280)..<((index + 1) * 1_280))
+            if index < 2 {
+              weight = interleave(weight, headDimension: 80)
+              bias = interleave(bias, headDimension: 80)
+            }
+            write("t-\(projection)-\(block)-0", weight)
+            write("t-\(projection)-\(block)-1", bias)
+          }
+          write("t-out_proj-\(block)-0", try read("\(prefix).attn.proj.weight"))
+          write("t-out_proj-\(block)-1", try read("\(prefix).attn.proj.bias"))
+          write("t-norm1-\(block)-0", try read("\(prefix).norm1.weight"))
+          write("t-norm2-\(block)-0", try read("\(prefix).norm2.weight"))
+          for name in ["gate_proj", "up_proj", "down_proj"] {
+            write("t-mlp-\(block)-mlp_\(name)-0-0", try read("\(prefix).mlp.\(name).weight"))
+            write("t-mlp-\(block)-mlp_\(name)-0-1", try read("\(prefix).mlp.\(name).bias"))
+          }
+        }
+        write("t-norm_out-0-0", try read("vision.merger.ln_q.weight"))
+        write("t-merger_mlp_0-0-0", try read("vision.merger.mlp.0.weight"))
+        write("t-merger_mlp_0-0-1", try read("vision.merger.mlp.0.bias"))
+        write("t-merger_mlp_1-0-0", try read("vision.merger.mlp.2.weight"))
+        write("t-merger_mlp_1-0-1", try read("vision.merger.mlp.2.bias"))
+        write("t-image_proj_0-0-0", try read("linear_proj.0.weight"))
+        write("t-image_proj_0-0-1", try read("linear_proj.0.bias"))
+        write("t-image_proj_2-0-0", try read("linear_proj.2.weight"))
+        write("t-image_proj_2-0-1", try read("linear_proj.2.bias"))
+      }
+    }
+    print("Wrote \(outputPath)")
+  }
+
+  /// The raw bytes of one tensor of a safetensors file (the header is 8 bytes of length and JSON).
+  private static func safetensorsBytes(of name: String, in url: URL) throws -> Data {
+    let handle = try FileHandle(forReadingFrom: url)
+    defer { try? handle.close() }
+    let lengthBytes = try handle.read(upToCount: 8) ?? Data()
+    let headerLength = lengthBytes.withUnsafeBytes { Int($0.loadUnaligned(as: UInt64.self)) }
+    let header = try handle.read(upToCount: headerLength) ?? Data()
+    guard
+      let json = try JSONSerialization.jsonObject(with: header) as? [String: Any],
+      let entry = json[name] as? [String: Any],
+      let offsets = entry["data_offsets"] as? [Int], offsets.count == 2
+    else { throw MingTextEncoderError.missingTensor(name) }
+    try handle.seek(toOffset: UInt64(8 + headerLength + offsets[0]))
+    return try handle.read(upToCount: offsets[1] - offsets[0]) ?? Data()
+  }
