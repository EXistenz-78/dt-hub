+  private enum MingTextEncoderError: Error {
+    case cannotOpenFile(String)
+    case missingTensor(String)
+  }
+
+  /// Converts Ming-Image's text encoder (the Ling MoE language model, the Qwen2 connector and the
+  /// projections) to the tensors `MingText.swift` reads: `__ming_text__[<parameter>]`. The ComfyUI
+  /// file stacks q, k and v and the experts' gate and up, the converter slices them. Vision tower,
+  /// `lm_head` and `linear_proj` are not needed for text-to-image and are left out.
+  private func convertMingTextEncoder() throws {
+    guard let safeTensors = SafeTensors(url: URL(fileURLWithPath: file)) else {
+      throw MingTextEncoderError.cannotOpenFile(file)
+    }
+    let states = safeTensors.states
+    let configuration = MingLingConfiguration.ming
+    let connector = MingConnectorConfiguration.ming
+    let graph = DynamicGraph()
+    let fileName = Importer.cleanup(filename: name)
+    let outputPath = URL(fileURLWithPath: outputDirectory)
+      .appendingPathComponent("\(fileName)_f16.ckpt").path
+    // Parameter names exist once a model is compiled; the shapes below only have to be valid.
+    let length = 16
+    func float32(_ shape: TensorShapeFormat) -> DynamicGraph.Tensor<Float> {
+      graph.variable(.GPU(0), shape, of: Float.self)
+    }
+    func half(_ shape: TensorShapeFormat) -> DynamicGraph.Tensor<FloatType> {
+      graph.variable(.GPU(0), shape, of: FloatType.self)
+    }
+    try graph.withNoGrad {
+      try graph.openStore(outputPath) { store in
+        store.removeAll()
+        try store.withTransaction {
+          func write(_ mapper: ModelWeightMapper) throws {
+            for (key, element) in mapper(.diffusers).sorted(by: { $0.key < $1.key }) {
+              let parts = key.split(separator: "#", maxSplits: 1).map(String.init)
+              guard let descriptor = states[parts[0]] else {
+                throw MingTextEncoderError.missingTensor(parts[0])
+              }
+              try safeTensors.with(descriptor) { source in
+                var tensor = Tensor<FloatType>(from: source)
+                if parts.count == 2 {
+                  let hidden = configuration.hiddenSize
+                  let queryRows = configuration.heads * configuration.headDimension
+                  let keyRows = configuration.keyValueHeads * configuration.headDimension
+                  switch parts[1] {
+                  case "q": tensor = tensor[0..<queryRows, 0..<hidden].copied()
+                  case "k": tensor = tensor[queryRows..<(queryRows + keyRows), 0..<hidden].copied()
+                  case "v":
+                    tensor = tensor[(queryRows + keyRows)..<(queryRows + 2 * keyRows), 0..<hidden]
+                      .copied()
+                  case "gate", "up":
+                    let intermediate = configuration.expertIntermediateSize
+                    let stacked = tensor.reshaped(
+                      .HWC(configuration.experts, 2 * intermediate, hidden))
+                    let start = parts[1] == "gate" ? 0 : intermediate
+                    tensor = stacked[
+                      0..<configuration.experts, start..<(start + intermediate), 0..<hidden
+                    ].copied()
+                  default: fatalError("Unknown slice \(parts[1])")
+                  }
+                }
+                element.write(
+                  graph: graph, to: store, tensor: tensor, format: element.format,
+                  isDiagonalUp: false, isDiagonalDown: false
+                ) { "__ming_text__[\($0)]" }
+              }
+            }
+          }
+          // Token embedding and the final norm.
+          do {
+            let (mapper, model) = MingLingEmbedding(
+              FloatType.self, tokenLength: length, configuration: configuration)
+            let tokens = graph.variable(.GPU(0), .C(length), of: Int32.self)
+            model.compile(
+              inputs: tokens, float32(.WC(length, 1)), float32(.WC(length, configuration.hiddenSize)))
+            try write(mapper)
+          }
+          do {
+            let (mapper, model) = MingLingFinalNorm(configuration: configuration)
+            model.compile(inputs: float32(.WC(length, configuration.hiddenSize)))
+            try write(mapper)
+          }
+          for layer in 0..<configuration.layers {
+            do {
+              let (mapper, model) = MingLingAttentionHalf(
+                FloatType.self, layer: layer, tokenLength: length, usesFlashAttention: true,
+                configuration: configuration)
+              model.compile(
+                inputs: float32(.WC(length, configuration.hiddenSize)),
+                half(.NHWC(1, length, 1, configuration.headDimension)),
+                half(.NHWC(1, 1, length, length)))
+              try write(mapper)
+            }
+            if layer < configuration.denseLayers {
+              let (mapper, model) = MingLingDenseHalf(
+                FloatType.self, layer: layer, configuration: configuration)
+              model.compile(
+                inputs: float32(.WC(length, configuration.hiddenSize)),
+                float32(.WC(length, configuration.hiddenSize)))
+              try write(mapper)
+            } else {
+              let (mapper, model) = MingLingMoEHalf(
+                layer: layer, tokenLength: length, configuration: configuration)
+              let selected = graph.variable(
+                .GPU(0), .WC(length, configuration.expertsPerToken), of: Int32.self)
+              model.compile(
+                inputs: float32(.WC(length, configuration.hiddenSize)),
+                float32(.WC(length, configuration.hiddenSize)),
+                float32(.WC(length, configuration.experts)), selected)
+              try write(mapper)
+              // The routing runs on the host, which needs the experts' score biases.
+              for gate in ["gate", "image_gate"] {
