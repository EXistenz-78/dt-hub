--- /dev/null
+++ b/Apps/SeamlessTileTest/check-call-sites.sh
@@ -0,0 +1,58 @@
+#!/bin/bash
+# Static check: the seamless flag reaches the image-grid RoPE calls of the four families
+# in UNetFixedEncoder.swift, and never the Ming-Image branch (it shares ZImageRotaryPositionEmbedding).
+set -u
+root="$(cd "$(dirname "$0")/../.." && pwd)"
+src="$root/Libraries/SwiftDiffusion/Sources/UNetFixedEncoder.swift"
+fail=0
+bad() { echo "FAIL: $1"; fail=1; }
+
+[ -f "$src" ] || { echo "FAIL: missing $src"; exit 1; }
+
+grep -q 'public var seamless: SeamlessTile? = nil' "$src" || bad "UNetFixedEncoder.seamless property missing"
+
+total=$(grep -c 'seamless: seamless' "$src")
+[ "$total" -eq 6 ] || bad "expected 6 occurrences of 'seamless: seamless', found $total"
+
+# Extent of a top-level `case` branch: from its line to the next 4-space-indented `case`/`default`.
+branch() {
+  awk -v pat="$1" '
+    $0 ~ "^    case " pat { on = 1; print; next }
+    on && /^    (case |default)/ { exit }
+    on { print }' "$src"
+}
+
+ming=$(branch '\\.mingImage:')
+[ -n "$ming" ] || bad "case .mingImage branch not found"
+echo "$ming" | grep -q 'ZImageRotaryPositionEmbedding(' || bad "mingImage branch lost its ZImage RoPE call (check script out of date)"
+echo "$ming" | grep -q 'seamless:' && bad "seamless: appears in the .mingImage branch"
+
+# Count calls whose argument list (up to the closing paren line) contains `seamless: seamless`.
+count_calls() { # $1 = text, $2 = type name, $3 = required marker (grep -E)
+  echo "$1" | awk -v t="$2" -v m="$3" '
+    index($0, t "(") { buf = $0; open = 1; next_line = 0 }
+    open && !index($0, t "(") { buf = buf "\n" $0 }
+    open && /\)[ ]*$|\)\)[ ]*$|\)\.toGPU/ { if (buf ~ m) good++; else other++; open = 0 }
+    END { print good + 0 }'
+}
+
+krea=$(count_calls "$(grep -n '' "$src" | sed 's/^[0-9]*://')" 'Krea2RotaryPositionEmbedding' 'seamless: seamless')
+[ "$krea" -eq 1 ] || bad "Krea 2: expected 1 call with seamless: seamless, found $krea"
+
+zi=$(branch '\\.zImage:')
+zcalls=$(count_calls "$zi" 'ZImageRotaryPositionEmbedding' 'height: h, width: w(.|\n)*seamless: seamless')
+[ "$zcalls" -eq 3 ] || bad "Z-Image: expected 3 image-grid calls with seamless: seamless, found $zcalls"
+# The text-only calls (height: 0) must not carry the flag.
+echo "$zi" | grep -A2 'height: 0, width: 0' | grep -q 'seamless:' && bad "Z-Image text-only call (height: 0) carries seamless:"
+
+f3=$(branch '\\.flux3_5b:')
+f3calls=$(count_calls "$f3" 'Flux3RotaryPositionEmbedding' 'height: h, width: w(.|\n)*seamless: seamless')
+[ "$f3calls" -eq 1 ] || bad "FLUX.3: expected 1 call with seamless: seamless, found $f3calls"
+
+f2=$(branch '\\.flux2, \\.flux2_9b, \\.flux2_4b:')
+f2calls=$(count_calls "$f2" 'Flux2RotaryPositionEmbedding' 'height: h, width: w(.|\n)*seamless: seamless')
+[ "$f2calls" -eq 1 ] || bad "FLUX.2: expected 1 call with seamless: seamless, found $f2calls"
+echo "$f2" | grep -A2 'height: 0, width: 0' | grep -q 'seamless:' && bad "FLUX.2 text-only call (height: 0) carries seamless:"
+
+if [ "$fail" -eq 0 ]; then echo "OK: seamless reaches Krea2 x1, Z-Image x3, FLUX.3 x1, FLUX.2 x1; never Ming"; fi
+exit $fail
diff --git a/Apps/SeamlessTileTest/e2e.sh b/Apps/SeamlessTileTest/e2e.sh
new file mode 100755
index 0000000..bd88a54
--- /dev/null
+++ b/Apps/SeamlessTileTest/e2e.sh
@@ -0,0 +1,123 @@
+#!/bin/bash
+# Seamless tile, end to end: one generation per family with draw-things-cli, then the seam check of the
+# ComfyUI node (comfyui-pixaroma/nodes/_seamless_helpers.py, seam_check) on each picture.
+#
+# Usage:
+#   e2e.sh                      generate with seamlessTile = 3 (both) and check; exit 1 if a direction is not PASS
+#   e2e.sh --baseline           generate WITHOUT seamlessTile and print "sha256  family.png" lines
+#   e2e.sh --seam <png>...      only run the seam check on existing pictures (exit 1 if a direction is not PASS)
+#
+# baseline.sha256 next to this script: e2e.sh --baseline with the defaults below, made with a Release
+# draw-things-cli built from bcdc18f (before the generator read the flag). With the flag off, a newer build
+# must give the same bytes:
+#   MODELS=<models folder> OUT=/tmp/x e2e.sh --baseline && (cd /tmp/x && shasum -a 256 -c "$HERE/baseline.sha256")
+# Ming-Image (FAMILIES=ming) is not in it: two runs of the same binary already differ (max 22/255, mean
+# ~0.5), so Ming is compared by pixel difference against that run-to-run spread, not by sha256.
+#
+# Environment, required:
+#   MODELS   models folder of DT Hub's managed server (generating: plain run and --baseline)
+#   COMFY    ComfyUI folder with the comfyui-pixaroma custom node (seam check: plain run and --seam)
+# Environment, optional:
+#   PY       Python with numpy, torch and Pillow (default: $COMFY/.venv/bin/python3)
+#   HELPERS  the node's helpers (default: $COMFY/custom_nodes/comfyui-pixaroma/nodes/_seamless_helpers.py)
+#   DTCLI    draw-things-cli binary            (default: .build/out/Products/Release/draw-things-cli)
+#   OUT      output folder                     (default: ./seamless-e2e-out)
+#   FAMILIES families to run, space separated  (default: "krea2 zimage flux2 flux3")
+#   PROMPT   prompt                            (default: a stone texture)
+#   SIZE     width and height in px            (default: 1024)
+#   STEPS    sampling steps                    (default: 8)
+#   SEED     seed                              (default: 7)
+#   EXTRA    extra JSON keys merged into --config-json, e.g. '"hiresFix":true'
+#   TAG      suffix for the output file names
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../.." && pwd)"
+DTCLI="${DTCLI:-$ROOT/.build/out/Products/Release/draw-things-cli}"
+MODELS="${MODELS:-}"
+OUT="${OUT:-$PWD/seamless-e2e-out}"
+FAMILIES="${FAMILIES:-krea2 zimage flux2 flux3}"
+PROMPT="${PROMPT:-seamless texture of rough grey stone, top-down, even lighting}"
+SIZE="${SIZE:-1024}"
+STEPS="${STEPS:-8}"
+SEED="${SEED:-7}"
+EXTRA="${EXTRA:-}"
+TAG="${TAG:-}"
+COMFY="${COMFY:-}"
+
+usage() {
+  echo "usage: MODELS=<models folder> COMFY=<ComfyUI folder> $0 [--baseline | --seam <png>...]" >&2
+  echo "  $1 is not set (see the Environment notes at the top of this script)." >&2
+  exit 2
+}
+
+# The seam check needs the ComfyUI node; generating needs the models folder.
+if [ "${1:-}" != "--baseline" ] && [ -z "${PY:-}" -o -z "${HELPERS:-}" ] && [ -z "$COMFY" ]; then usage COMFY; fi
+if [ "${1:-}" != "--seam" ] && [ -z "$MODELS" ]; then usage MODELS; fi
+PY="${PY:-$COMFY/.venv/bin/python3}"
+HELPERS="${HELPERS:-$COMFY/custom_nodes/comfyui-pixaroma/nodes/_seamless_helpers.py}"
+
+model_for() {
+  case "$1" in
+    krea2) echo krea_2_turbo_i8x.ckpt ;;
+    zimage) echo z_image_1.0_i8x.ckpt ;;
+    flux2) echo flux_2_klein_9b_i8x.ckpt ;;
+    flux3) echo flux_3_klein_i8x.ckpt ;;
+    ming) echo ming_image_0.1_design_i8x.ckpt ;;
+    *) echo "unknown family $1" >&2; exit 2 ;;
+  esac
+}
+
+seam() {
+  # Prints one line per picture and exits 1 if a direction is not PASS.
+  "$PY" -I - "$HELPERS" "$@" <<'EOF'
+import importlib.util, sys
+import numpy as np, torch
+from PIL import Image
+spec = importlib.util.spec_from_file_location("seamless_helpers", sys.argv[1])
+h = importlib.util.module_from_spec(spec); spec.loader.exec_module(h)
+bad = 0
+for path in sys.argv[2:]:
+    img = torch.from_numpy(np.asarray(Image.open(path).convert("RGB"), dtype=np.float32) / 255.0)
+    r = h.seam_check(img)
+    lr, ud = r["left_right"], r["up_down"]
+    print(f"{path}: LR {lr['status']} ratio={lr['ratio']} vs_worst={lr.get('vs_worst')}  "
+          f"UD {ud['status']} ratio={ud['ratio']} vs_worst={ud.get('vs_worst')}")
+    bad += lr["status"] != "PASS" or ud["status"] != "PASS"
+sys.exit(1 if bad else 0)
+EOF
+}
+
+generate() { # family json output
+  "$DTCLI" generate --local --offline --disable-preview --models-dir "$MODELS" --model "$(model_for "$1")" \
+    --prompt "$PROMPT" --width "$SIZE" --height "$SIZE" --steps "$STEPS" --seed "$SEED" \
+    --config-json "$2" --output "$3"
+}
+
+json() { # seamless(0/1)
+  local keys=()
+  [ "$1" = 1 ] && keys+=('"seamlessTile":3')
+  [ -n "$EXTRA" ] && keys+=("$EXTRA")
+  local IFS=,
+  echo "{${keys[*]-}}"
+}
+
+if [ "${1:-}" = "--seam" ]; then
+  shift; seam "$@"; exit $?
+fi
+
+mkdir -p "$OUT"
+if [ "${1:-}" = "--baseline" ]; then
+  for f in $FAMILIES; do
+    generate "$f" "$(json 0)" "$OUT/$f$TAG.png" >"$OUT/$f$TAG.log" 2>&1
+    (cd "$OUT" && shasum -a 256 "$f$TAG.png")
+  done
+  exit 0
+fi
+
+pngs=()
+for f in $FAMILIES; do
+  generate "$f" "$(json 1)" "$OUT/$f-seamless$TAG.png" >"$OUT/$f-seamless$TAG.log" 2>&1
+  pngs+=("$OUT/$f-seamless$TAG.png")
+done
+seam "${pngs[@]}"
diff --git a/Apps/SeamlessTileTest/main.swift b/Apps/SeamlessTileTest/main.swift
new file mode 100644
index 0000000..2e54bf8
--- /dev/null
+++ b/Apps/SeamlessTileTest/main.swift
@@ -0,0 +1,973 @@
+import Diffusion
+import Foundation
+import NNC
+
+func check(_ condition: Bool, _ message: String) {
+  if !condition {
+    print("FAIL: \(message)")
+    exit(1)
+  }
+}
+
+// Configuration values.
+check(SeamlessTile(configurationValue: 0) == nil, "0 is off")
+check(
+  SeamlessTile(configurationValue: 1) == SeamlessTile(wrapsHeight: false, wrapsWidth: true),
+  "1 wraps the width only")
+check(
+  SeamlessTile(configurationValue: 2) == SeamlessTile(wrapsHeight: true, wrapsWidth: false),
+  "2 wraps the height only")
+check(
+  SeamlessTile(configurationValue: 3) == SeamlessTile(wrapsHeight: true, wrapsWidth: true),
+  "3 wraps both")
+check(SeamlessTile(configurationValue: 9) == nil, "an unknown value is off")
+check(SeamlessTile(configurationValue: -1) == nil, "a negative value is off")
+
+// Minimum turns per version.
+check(SeamlessTile.minTurns(for: .zImage) == 1.0, "Z-Image 1.0")
+check(SeamlessTile.minTurns(for: .krea2) == 1.0, "Krea 2 1.0")
+check(SeamlessTile.minTurns(for: .flux2) == 0.5, "FLUX.2 0.5")
+check(SeamlessTile.minTurns(for: .flux2_9b) == 0.5, "FLUX.2 9B 0.5")
+check(SeamlessTile.minTurns(for: .flux2_4b) == 0.5, "FLUX.2 4B 0.5")
+check(SeamlessTile.minTurns(for: .flux3_5b) == 0.5, "FLUX.3 0.5")
+check(SeamlessTile.minTurns(for: .mingImage) == nil, "Ming-Image is not supported")
+check(SeamlessTile.minTurns(for: .flux1) == nil, "FLUX.1 is not supported")
+
+// The angle at one period equals the angle at zero, for every theta and axis size.
+let period = 64.0
+for theta in [256.0, 1000.0, 2000.0, 10000.0] {
+  for dim in [48, 32] {
+    let half = dim / 2
+    for i in 0..<half {
+      let omega = 1.0 / pow(theta, Double(i) / Double(half))
+      for minTurns in [0.5, 1.0] {
+        let end = torusAngle(position: period, omega: omega, period: period, minTurns: minTurns)
+        let start = torusAngle(position: 0, omega: omega, period: period, minTurns: minTurns)
+        check(abs(cos(end) - cos(start)) < 1e-9, "cos wraps (theta \(theta), dim \(dim), i \(i))")
+        check(abs(sin(end) - sin(start)) < 1e-9, "sin wraps (theta \(theta), dim \(dim), i \(i))")
+        // Any position repeats one period later.
+        let a = torusAngle(position: 17, omega: omega, period: period, minTurns: minTurns)
+        let b = torusAngle(position: 17 + period, omega: omega, period: period, minTurns: minTurns)
+        check(abs(cos(a) - cos(b)) < 1e-9 && abs(sin(a) - sin(b)) < 1e-9, "periodic at 17")
+      }
+    }
+  }
+}
+
+// A slow frequency (about 0.10 turns over the period) becomes constant.
+check(
+  torusFrequency(omega: 0.01, period: 64, minTurns: 0.5) == 0, "a slow frequency is zeroed")
+// 2.6 turns over the period snaps to 3 whole turns.
+let omega26 = 2.6 * 2 * Double.pi / 64
+check(
+  abs(torusFrequency(omega: omega26, period: 64, minTurns: 0.5) - 3 * 2 * Double.pi / 64) < 1e-12,
+  "2.6 turns snap to 3")
+
+// MARK: RoPE on the torus.
+
+let gridH = 8
+let gridW = 12
+let textLen = 7
+
+func sameFloats<T: TensorNumeric & BinaryFloatingPoint>(
+  _ a: Tensor<T>, _ b: Tensor<T>, _ message: String
+) {
+  check(a.shape[0] == b.shape[0] && a.shape[1] == b.shape[1], "\(message): same token count")
+  check(a.shape[2] == b.shape[2] && a.shape[3] == b.shape[3], "\(message): same shape")
+  for t in 0..<a.shape[1] {
+    for h in 0..<a.shape[2] {
+      for c in 0..<a.shape[3] {
+        if a[0, t, h, c] != b[0, t, h, c] {
+          print("FAIL: \(message) differs at token \(t) head \(h) channel \(c)")
+          exit(1)
+        }
+      }
+    }
+  }
+}
+
+/// Layout of one function's output: where the height and width pairs sit and how many leading
+/// tokens are image tokens (laid out as y * gridW + x).
+struct RopeLayout {
+  var name: String
+  var heads: Int
+  var heightPairs: Range<Int>
+  var widthPairs: Range<Int>
+  var imageTokens: Int
+}
+
+func angle(_ t: Tensor<Float>, _ token: Int, _ head: Int, _ pair: Int) -> Double {
+  return atan2(Double(t[0, token, head, pair * 2 + 1]), Double(t[0, token, head, pair * 2]))
+}
+
+/// The step between two neighbours times the period is a whole number of turns.
+func checkPeriodic(
+  _ t: Tensor<Float>, _ layout: RopeLayout, axisIsWidth: Bool
+) {
+  let pairs = axisIsWidth ? layout.widthPairs : layout.heightPairs
+  let period = Double(axisIsWidth ? gridW : gridH)
+  var movingChannels = 0
+  for head in 0..<layout.heads {
+    for pair in pairs {
+      // Several rows (columns) to be sure it is the same for every one of them.
+      for line in 0..<(axisIsWidth ? gridH : gridW) {
+        let t0 = axisIsWidth ? line * gridW : line
+        let t1 = axisIsWidth ? line * gridW + 1 : gridW + line
+        var step = angle(t, t1, head, pair) - angle(t, t0, head, pair)
+        step -= (step / (2 * Double.pi)).rounded() * 2 * Double.pi
+        let total = step * period
+        let turns = (total / (2 * Double.pi)).rounded()
+        check(
+          abs(total - turns * 2 * Double.pi) < 1e-5,
+          "\(layout.name): \(axisIsWidth ? "width" : "height") pair \(pair) is not periodic")
+        if line == 0 && head == 0 && abs(step) > 1e-9 { movingChannels += 1 }
+      }
+    }
+  }
+  check(movingChannels > 0, "\(layout.name): some channel of the axis still turns")
+}
+
+func checkTorus(
+  _ layout: RopeLayout, off: Tensor<Float>, both: Tensor<Float>, widthOnly: Tensor<Float>
+) {
+  check(off.shape[1] == both.shape[1], "\(layout.name): same token count")
+  checkPeriodic(both, layout, axisIsWidth: true)
+  checkPeriodic(both, layout, axisIsWidth: false)
+  // Everything but the height and width channels of the image tokens is the same as without.
+  for t in 0..<off.shape[1] {
+    for h in 0..<off.shape[2] {
+      for c in 0..<off.shape[3] {
+        let pair = c / 2
+        let isAxis =
+          t < layout.imageTokens
+          && (layout.heightPairs.contains(pair) || layout.widthPairs.contains(pair))
+        if !isAxis {
+          check(
+            both[0, t, h, c] == off[0, t, h, c] && widthOnly[0, t, h, c] == off[0, t, h, c],
+            "\(layout.name): token \(t) channel \(c) is unchanged")
+        }
+        // Width only: the height channels are the same as without.
+        if t < layout.imageTokens && layout.heightPairs.contains(pair) {
+          check(
+            widthOnly[0, t, h, c] == off[0, t, h, c],
+            "\(layout.name): width only leaves the height channel \(c) alone")
+        }
+      }
+    }
+  }
+  // The torus really changed something.
+  var changed = false
+  for t in 0..<layout.imageTokens {
+    for c in 0..<off.shape[3] where both[0, t, 0, c] != off[0, t, 0, c] { changed = true }
+  }
+  check(changed, "\(layout.name): the torus changes the image tokens")
+}
+
+let both = SeamlessTile(configurationValue: 3)
+let widthOnly = SeamlessTile(configurationValue: 1)
+let heightOnly = SeamlessTile(configurationValue: 2)
+
+// Krea 2 (Float16 and Float, as the call sites use FloatType).
+for references in [0, 1] {
+  sameFloats(
+    Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self, seamless: nil),
+    referenceKrea2Rope(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self),
+    "Krea 2 nil (Float, \(references) references)")
+  sameFloats(
+    Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float16.self, seamless: nil),
+    referenceKrea2Rope(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float16.self),
+    "Krea 2 nil (Float16, \(references) references)")
+}
+do {
+  func krea(_ s: SeamlessTile?, _ references: Int) -> Tensor<Float> {
+    return Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "Krea 2", heads: 1, heightPairs: 16..<40, widthPairs: 40..<64,
+    imageTokens: gridH * gridW)
+  checkTorus(
+    layout, off: krea(nil, 0), both: krea(both, 0), widthOnly: krea(widthOnly, 0))
+  let heightTensor = krea(heightOnly, 0)
+  let offTensor = krea(nil, 0)
+  for t in 0..<(gridH * gridW) {
+    for c in (40 * 2)..<(64 * 2) {
+      check(heightTensor[0, t, 0, c] == offTensor[0, t, 0, c], "Krea 2 height only keeps width")
+    }
+  }
+  // One reference: its tokens carry the same y / x angles as the image tokens.
+  let withReference = krea(both, 1)
+  let imageCount = gridH * gridW
+  for t in 0..<imageCount {
+    for c in (16 * 2)..<(64 * 2) {
+      check(
+        withReference[0, t, 0, c] == withReference[0, t + imageCount, 0, c],
+        "Krea 2 reference token \(t) channel \(c) has the image angles")
+    }
+  }
+  // The frame axis and the text are as without.
+  let withReferenceOff = krea(nil, 1)
+  for t in 0..<withReference.shape[1] {
+    for c in 0..<(16 * 2) {
+      check(withReference[0, t, 0, c] == withReferenceOff[0, t, 0, c], "Krea 2 frame axis")
+    }
+    if t >= 2 * imageCount {
+      for c in 0..<(64 * 2) {
+        check(withReference[0, t, 0, c] == withReferenceOff[0, t, 0, c], "Krea 2 text row")
+      }
+    }
+  }
+}
+
+// Z-Image.
+for references in [0, 1] {
+  sameFloats(
+    ZImageRotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      referenceFrames: references, seamless: nil),
+    referenceZImageRope(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      referenceFrames: references),
+    "Z-Image nil (\(references) reference frames)")
+}
+sameFloats(
+  ZImageRotaryPositionEmbedding(
+    height: 0, width: 0, tokenLength: 32, imagePaddedLength: 0, seamless: nil),
+  referenceZImageRope(height: 0, width: 0, tokenLength: 32, imagePaddedLength: 0),
+  "Z-Image nil (text only)")
+do {
+  func z(_ s: SeamlessTile?) -> Tensor<Float> {
+    return ZImageRotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "Z-Image", heads: 2, heightPairs: 16..<40, widthPairs: 40..<64,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: z(nil), both: z(both), widthOnly: z(widthOnly))
+}
+
+// FLUX.2.
+let flux2References = [(height: 4, width: 6)]
+sameFloats(
+  Flux2RotaryPositionEmbedding(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2, seamless: nil),
+  referenceFlux2Rope(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2),
+  "FLUX.2 nil")
+do {
+  func f2(_ s: SeamlessTile?) -> Tensor<Float> {
+    return Flux2RotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+      channels: 128, heads: 2, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "FLUX.2", heads: 2, heightPairs: 16..<32, widthPairs: 32..<48,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: f2(nil), both: f2(both), widthOnly: f2(widthOnly))
+}
+
+// FLUX.3 (positions are y * 0.5 and x * 0.5, so the period is the grid * 0.5).
+sameFloats(
+  Flux3RotaryPositionEmbedding(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2, seamless: nil),
+  referenceFlux3Rope(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2),
+  "FLUX.3 nil")
+do {
+  func f3(_ s: SeamlessTile?) -> Tensor<Float> {
+    return Flux3RotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+      channels: 128, heads: 2, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "FLUX.3", heads: 2, heightPairs: 16..<32, widthPairs: 32..<48,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: f3(nil), both: f3(both), widthOnly: f3(widthOnly))
+}
+
+// MARK: Wrap padding in the VAE decoder.
+
+let wrapGraph = DynamicGraph()
+
+// The graphs run on the GPU: the CPU reference convolution does not take OIHW weights with NHWC
+// inputs, which is what the decoder uses.
+func runModel(_ model: Model, _ input: Tensor<Float>) -> Tensor<Float> {
+  return wrapGraph.withNoGrad {
+    let x = wrapGraph.variable(input.toGPU(0))
+    return model(inputs: x)[0].as(of: Float.self).rawValue.toCPU()
+  }
+}
+
+func randomTensor(_ shape: [Int]) -> Tensor<Float> {
+  var t = Tensor<Float>(.CPU, .NHWC(shape[0], shape[1], shape[2], shape[3]))
+  for n in 0..<shape[0] {
+    for y in 0..<shape[1] {
+      for x in 0..<shape[2] {
+        for c in 0..<shape[3] { t[n, y, x, c] = Float.random(in: -1...1) }
+      }
+    }
+  }
+  return t
+}
+
+/// The input repeated `rows` times down and `columns` times across (NHWC).
+func tiled(_ t: Tensor<Float>, rows: Int, columns: Int) -> Tensor<Float> {
+  let (n, h, w, c) = (t.shape[0], t.shape[1], t.shape[2], t.shape[3])
+  var out = Tensor<Float>(.CPU, .NHWC(n, h * rows, w * columns, c))
+  for b in 0..<n {
+    for y in 0..<(h * rows) {
+      for x in 0..<(w * columns) {
+        for k in 0..<c { out[b, y, x, k] = t[b, y % h, x % w, k] }
+      }
+    }
+  }
+  return out
+}
+
+/// The largest absolute difference between `a` and the window of `b` at (`top`, `left`).
+func maxDifference(_ a: Tensor<Float>, _ b: Tensor<Float>, top: Int, left: Int) -> Float {
+  var worst: Float = 0
+  for n in 0..<a.shape[0] {
+    for y in 0..<a.shape[1] {
+      for x in 0..<a.shape[2] {
+        for c in 0..<a.shape[3] {
+          worst = max(worst, abs(a[n, y, x, c] - b[n, y + top, x + left, c]))
+        }
+      }
+    }
+  }
+  return worst
+}
+
+// WrapPad on a known 1x4x5x1 tensor: the opposite edges come around.
+do {
+  var known = Tensor<Float>(.CPU, .NHWC(1, 4, 5, 1))
+  for y in 0..<4 {
+    for x in 0..<5 { known[0, y, x, 0] = Float(y * 10 + x) }
+  }
+  let both = runModel(
+    WrapPad(
+      batchSize: 1, height: 4, width: 5, channels: 1, top: 1, left: 1, wrapsHeight: true,
+      wrapsWidth: true), known)
+  check(both.shape[1] == 6 && both.shape[2] == 7, "WrapPad both gives 1x6x7x1")
+  for y in 0..<6 {
+    for x in 0..<7 {
+      let expected = Float(((y + 3) % 4) * 10 + (x + 4) % 5)
+      check(both[0, y, x, 0] == expected, "WrapPad both at \(y), \(x)")
+    }
+  }
+  let heightOnly = runModel(
+    WrapPad(
+      batchSize: 1, height: 4, width: 5, channels: 1, top: 1, left: 1, wrapsHeight: true,
+      wrapsWidth: false), known)
+  check(heightOnly.shape[1] == 6 && heightOnly.shape[2] == 5, "WrapPad height gives 1x6x5x1")
+  for y in 0..<6 {
+    for x in 0..<5 {
+      check(
+        heightOnly[0, y, x, 0] == Float(((y + 3) % 4) * 10 + x), "WrapPad height at \(y), \(x)")
+    }
+  }
+}
+
+// A wrapping 3x3 convolution equals the same convolution on the 3x3 tile, cropped to the center.
+// The other axis keeps its zero border.
+do {
+  let input = randomTensor([1, 8, 8, 4])
+  var weight = Tensor<Float>(.CPU, .NCHW(3, 4, 3, 3))
+  for o in 0..<3 {
+    for i in 0..<4 {
+      for y in 0..<3 {
+        for x in 0..<3 { weight[o, i, y, x] = Float.random(in: -1...1) }
+      }
+    }
+  }
+  var bias = Tensor<Float>(.CPU, .C(3))
+  for o in 0..<3 { bias[o] = Float.random(in: -1...1) }
+  let border = Hint.Border(begin: [1, 1], end: [1, 1])
+  for (value, rows, columns) in [(Int8(3), 3, 3), (Int8(2), 3, 1), (Int8(1), 1, 3)] {
+    let wrap = SeamlessTile(configurationValue: value)!
+    let (conv, apply) = WrappingConvolution(
+      groups: 1, filters: 3, filterSize: [3, 3], border: border, wrap: wrap,
+      inputShape: (batchSize: 1, height: 8, width: 8, channels: 4), format: .OIHW)
+    let x = Input()
+    let wrapping = Model([x], [apply(x)])
+    wrapGraph.withNoGrad {
+      wrapping.compile(inputs: wrapGraph.variable(input.toGPU(0)))
+    }
+    conv.weight.copy(from: weight)
+    conv.bias.copy(from: bias)
+    let reference = Convolution(
+      groups: 1, filters: 3, filterSize: [3, 3], hint: Hint(stride: [1, 1], border: border),
+      format: .OIHW)
+    let tile = tiled(input, rows: rows, columns: columns)
+    wrapGraph.withNoGrad {
+      reference.compile(inputs: wrapGraph.variable(tile.toGPU(0)))
+    }
+    reference.weight.copy(from: weight)
+    reference.bias.copy(from: bias)
+    let out = runModel(wrapping, input)
+    let expected = runModel(reference, tile)
+    check(out.shape[1] == 8 && out.shape[2] == 8, "wrapping conv \(value) keeps 8x8")
+    let difference = maxDifference(
+      out, expected, top: rows == 3 ? 8 : 0, left: columns == 3 ? 8 : 0)
+    check(difference < 1e-4, "wrapping conv \(value) matches the tile (\(difference))")
+  }
+}
+
+/// The input moved by `dy` rows and `dx` columns, wrapping around (NHWC).
+func rolled(_ t: Tensor<Float>, _ dy: Int, _ dx: Int) -> Tensor<Float> {
+  let (n, h, w, c) = (t.shape[0], t.shape[1], t.shape[2], t.shape[3])
+  var out = Tensor<Float>(.CPU, .NHWC(n, h, w, c))
+  for b in 0..<n {
+    for y in 0..<h {
+      for x in 0..<w {
+        for k in 0..<c { out[b, (y + dy) % h, (x + dx) % w, k] = t[b, y, x, k] }
+      }
+    }
+  }
+  return out
+}
+
+// The Decoder with wrap reads the same weights as without (same parameter names, the plain one
+// reads the wrapping one's file strictly). A wrapping decoder commutes with a circular shift on
+// its wrapped axes: group norm and attention don't see positions and every padded convolution
+// is circular, so moving the latent by (1, 1) moves the picture by (2, 2) with one upsampling.
+// The plain decoder does not (its zero borders break the shift), which shows the check bites.
+// (Comparing with the plain decoder on a tiled latent can't work: the mid attention is global
+// and the receptive field is wider than one tile.)
+func decoderKeys(_ model: Model, _ path: String) -> [String] {
+  var keys = [String]()
+  wrapGraph.openStore(path) { store in
+    store.write("decoder", model: model)
+    keys = store.keys.sorted()
+  }
+  return keys
+}
+for (specializingNames, value) in [(false, Int8(3)), (true, Int8(3)), (true, Int8(1))] {
+  let wrap = SeamlessTile(configurationValue: value)!
+  func makeDecoder(wrap: SeamlessTile?) -> Model {
+    return Decoder(
+      channels: [32, 32], numRepeat: 1, batchSize: 1, startWidth: 4, startHeight: 4,
+      inputChannels: 16, highPrecisionKeysAndValues: false, usesFlashAttention: false,
+      paddingFinalConvLayer: true, format: .NHWC, quantLayer: true,
+      specializingNames: specializingNames, wrap: wrap
+    ).0
+  }
+  let latent = randomTensor([1, 4, 4, 16])
+  let dy = wrap.wrapsHeight ? 1 : 0
+  let dx = wrap.wrapsWidth ? 1 : 0
+  let wrapping = makeDecoder(wrap: wrap)
+  let plain = makeDecoder(wrap: nil)
+  // The parameters exist once a model has run.
+  let out = runModel(wrapping, latent)
+  _ = runModel(plain, latent)
+  let directory = FileManager.default.temporaryDirectory
+  let wrapPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  let plainPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  defer {
+    try? FileManager.default.removeItem(atPath: wrapPath)
+    try? FileManager.default.removeItem(atPath: plainPath)
+  }
+  let wrapKeys = decoderKeys(wrapping, wrapPath)
+  let plainKeys = decoderKeys(plain, plainPath)
+  check(
+    !wrapKeys.isEmpty && wrapKeys == plainKeys,
+    "Decoder parameter names (specializingNames \(specializingNames)) are the same with wrap")
+  var readError: Error? = nil
+  wrapGraph.openStore(wrapPath, flags: .readOnly) { store in
+    do {
+      try store.read("decoder", model: plain, strict: true)
+    } catch {
+      readError = error
+    }
+  }
+  check(readError == nil, "the plain Decoder reads the wrapping Decoder's weights")
+  check(out.shape[1] == 8 && out.shape[2] == 8 && out.shape[3] == 4, "Decoder output 1x8x8x4")
+  let shifted = runModel(wrapping, rolled(latent, dy, dx))
+  let difference = maxDifference(rolled(out, 2 * dy, 2 * dx), shifted, top: 0, left: 0)
+  check(
+    difference < 1e-3,
+    "Decoder with wrap \(value) (specializingNames \(specializingNames)) commutes with the shift"
+      + " (\(difference))")
+  let plainOut = runModel(plain, latent)
+  let plainShifted = runModel(plain, rolled(latent, dy, dx))
+  let plainDifference = maxDifference(
+    rolled(plainOut, 2 * dy, 2 * dx), plainShifted, top: 0, left: 0)
+  check(
+    plainDifference > 1e-2,
+    "the plain Decoder does not commute with the shift (\(plainDifference))")
+}
+
+// MARK: Wrap padding in the Wan VAE decoder (Krea 2).
+
+// On one frame the causal 3x3x3 convolution is a 3x3 one: with wrap it equals the same convolution
+// on the 3x3 tile, cropped to the center; the other axis keeps its zero border. The input is not
+// square (4x6) so a swapped height and width would show.
+do {
+  let input = randomTensor([1, 4, 6, 4])
+  var weight = Tensor<Float>(.CPU, .NCHW(3, 4, 3, 3))
+  for o in 0..<3 {
+    for i in 0..<4 {
+      for y in 0..<3 {
+        for x in 0..<3 { weight[o, i, y, x] = Float.random(in: -1...1) }
+      }
+    }
+  }
+  var bias = Tensor<Float>(.CPU, .C(3))
+  for o in 0..<3 { bias[o] = Float.random(in: -1...1) }
+  for (value, rows, columns) in [(Int8(3), 3, 3), (Int8(2), 3, 1), (Int8(1), 1, 3)] {
+    let wrap = SeamlessTile(configurationValue: value)!
+    let (conv, apply) = WanFrameConvolution(filters: 3, wrap: wrap, name: "resnet_conv1")
+    let x = Input()
+    let wrapping = Model([x], [apply(x, (depth: 1, height: 4, width: 6, channels: 4))])
+    wrapGraph.withNoGrad {
+      wrapping.compile(inputs: wrapGraph.variable(input.toGPU(0)))
+    }
+    conv.weight.copy(from: weight)
+    conv.bias.copy(from: bias)
+    let (reference, applyReference) = WanFrameConvolution(filters: 3, wrap: nil, name: "")
+    let tile = tiled(input, rows: rows, columns: columns)
+    let y = Input()
+    let plain = Model([y], [applyReference(y, (depth: 1, height: 4 * rows, width: 6 * columns, channels: 4))])
+    wrapGraph.withNoGrad {
+      plain.compile(inputs: wrapGraph.variable(tile.toGPU(0)))
+    }
+    reference.weight.copy(from: weight)
+    reference.bias.copy(from: bias)
+    let out = runModel(wrapping, input)
+    let expected = runModel(plain, tile)
+    check(out.shape[1] == 4 && out.shape[2] == 6, "Wan frame conv \(value) keeps 4x6")
+    let difference = maxDifference(
+      out, expected, top: rows == 3 ? 4 : 0, left: columns == 3 ? 6 : 0)
+    check(difference < 1e-4, "Wan frame conv \(value) matches the tile (\(difference))")
+  }
+}
+
+// WanDecoderCausal3D on one frame: the same parameter names with and without wrap (the plain one
+// reads the wrapping one's file strictly), and the wrapping decoder commutes with a circular shift
+// on its wrapped axes (RMS norm and attention don't see positions, every padded convolution is
+// circular; two upsamplings make a 1-latent shift a 4-pixel one). The plain decoder does not.
+for value in [Int8(3), Int8(1), Int8(2)] {
+  let wrap = SeamlessTile(configurationValue: value)!
+  func makeWanDecoder(wrap: SeamlessTile?) -> Model {
+    return WanDecoderCausal3D(
+      channels: [8, 16, 16], numRepeat: 1, startWidth: 6, startHeight: 4, startDepth: 1,
+      paddingFinalConvLayer: true, wan22: false, outputChannels: 3,
+      highPrecisionFinalNorm: false, usesFlashAttention: false, format: .NHWC, wrap: wrap
+    ).1
+  }
+  let latent = randomTensor([1, 4, 6, 16])
+  let dy = wrap.wrapsHeight ? 1 : 0
+  let dx = wrap.wrapsWidth ? 1 : 0
+  let wrapping = makeWanDecoder(wrap: wrap)
+  let plain = makeWanDecoder(wrap: nil)
+  let out = runModel(wrapping, latent)
+  _ = runModel(plain, latent)
+  let directory = FileManager.default.temporaryDirectory
+  let wrapPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  let plainPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  defer {
+    try? FileManager.default.removeItem(atPath: wrapPath)
+    try? FileManager.default.removeItem(atPath: plainPath)
+  }
+  let wrapKeys = decoderKeys(wrapping, wrapPath)
+  let plainKeys = decoderKeys(plain, plainPath)
+  check(
+    !wrapKeys.isEmpty && wrapKeys == plainKeys,
+    "WanDecoderCausal3D parameter names are the same with wrap \(value)")
+  var readError: Error? = nil
+  wrapGraph.openStore(wrapPath, flags: .readOnly) { store in
+    do {
+      try store.read("decoder", model: plain, strict: true)
+    } catch {
+      readError = error
+    }
+  }
+  check(readError == nil, "the plain WanDecoderCausal3D reads the wrapping one's weights")
+  check(
+    out.shape[0] == 1 && out.shape[1] == 16 && out.shape[2] == 24 && out.shape[3] == 4,
+    "WanDecoderCausal3D output 1x16x24x4 (\(out.shape))")
+  let shifted = runModel(wrapping, rolled(latent, dy, dx))
+  let difference = maxDifference(rolled(out, 4 * dy, 4 * dx), shifted, top: 0, left: 0)
+  check(
+    difference < 1e-3,
+    "WanDecoderCausal3D with wrap \(value) commutes with the shift (\(difference))")
+  let plainOut = runModel(plain, latent)
+  let plainShifted = runModel(plain, rolled(latent, dy, dx))
+  let plainDifference = maxDifference(
+    rolled(plainOut, 4 * dy, 4 * dx), plainShifted, top: 0, left: 0)
+  check(
+    plainDifference > 1e-2,
+    "the plain WanDecoderCausal3D does not commute with the shift (\(plainDifference))")
+}
