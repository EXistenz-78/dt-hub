+import Foundation
+import NNC
+
+// Ming-Image 0.1's text conditioning: the Ling (BailingMoeV2) language model, run over the chat
+// prompt followed by 256 learnable query tokens, a bidirectional Qwen2 connector over those 256
+// outputs, and the projections that turn both into the DiT's caption features.
+// Reference: https://github.com/inclusionAI/Ming-Image (modeling_bailing_moe_v2.py,
+// modeling_bailingmm2.py). The numbers a port must match are in DT Hub's
+// docs/superpowers/specs/2026-11-23-ming-image-design.md (section 6b).
+//
+// The language model runs one layer per graph. A MoE layer is two graphs, with the routing in
+// between on the host: BailingMoeV2 picks experts inside score groups (8 groups, best 4, then the
+// top 8), which MoERouting cannot do, so the host chooses the experts and MoERouting only weights
+// them (`preselected`).
+
+public struct MingLingConfiguration {
+  public var hiddenSize = 2_048
+  public var layers = 20
+  public var heads = 16
+  public var keyValueHeads = 4
+  public var headDimension = 128
+  /// Only the first half of each head is rotated (partial_rotary_factor 0.5).
+  public var rotaryDimension = 64
+  /// `mrope_section` [8, 12, 12] under video_rope: pairs 0..<24 alternate height and width, the
+  /// remaining 8 use time.
+  public var rotarySpatialPairs = 24
+  public var ropeTheta: Double = 600_000
+  public var denseLayers = 1
+  public var denseIntermediateSize = 5_120
+  public var experts = 256
+  public var expertsPerToken = 8
+  public var expertGroups = 8
+  public var selectedGroups = 4
+  public var expertIntermediateSize = 512
+  public var routedScalingFactor: Float = 2.5
+  public var vocabularySize = 157_184
+  public var normEpsilon: Float = 1e-6
+  public init() {}
+  public static let ming = MingLingConfiguration()
+}
+
+/// The Qwen2 connector (bidirectional) and the projections around it.
+public struct MingConnectorConfiguration {
+  public var inputSize = 2_048
+  public var hiddenSize = 1_536
+  public var layers = 28
+  public var heads = 12
+  public var keyValueHeads = 2
+  public var headDimension = 128
+  public var intermediateSize = 8_960
+  public var outputSize = 2_560
+  public var ropeTheta: Double = 1_000_000
+  public var normEpsilon: Float = 1e-6
+  public init() {}
+  public static let ming = MingConnectorConfiguration()
+}
+
+/// Rotary table for the language model: `[1, length, 1, headDimension]` as (cos, sin) pairs. The
+/// first `rotaryDimension / 2` pairs rotate with the height, width or time position of the token
+/// (`positions` is `[3][length]` in the order time, height, width); the rest are identity.
+public func MingLingRotaryEmbedding<FloatType: TensorNumeric & BinaryFloatingPoint>(
+  positions: [[Int]], configuration: MingLingConfiguration = .ming,
+  of dataType: FloatType.Type = FloatType.self
+) -> Tensor<FloatType> {
+  precondition(positions.count == 3)
+  let length = positions[0].count
+  let pairs = configuration.headDimension / 2
+  let rotatedPairs = configuration.rotaryDimension / 2
+  var rotary = Tensor<FloatType>(.CPU, .NHWC(1, length, 1, configuration.headDimension))
+  for i in 0..<length {
+    for k in 0..<pairs {
+      guard k < rotatedPairs else {
+        rotary[0, i, 0, k * 2] = 1
+        rotary[0, i, 0, k * 2 + 1] = 0
+        continue
+      }
+      // Time is row 0, height row 1, width row 2.
+      let row = k < configuration.rotarySpatialPairs ? (k % 2 == 0 ? 1 : 2) : 0
+      let frequency = 1.0 / pow(configuration.ropeTheta, Double(k * 2) / Double(rotatedPairs * 2))
+      let angle = Double(positions[row][i]) * frequency
+      rotary[0, i, 0, k * 2] = FloatType(cos(angle))
+      rotary[0, i, 0, k * 2 + 1] = FloatType(sin(angle))
+    }
+  }
+  return rotary
+}
+
+/// Rotary table of the connector: ordinary rotary over the whole head.
+public func MingConnectorRotaryEmbedding<FloatType: TensorNumeric & BinaryFloatingPoint>(
+  length: Int, configuration: MingConnectorConfiguration = .ming,
+  of dataType: FloatType.Type = FloatType.self
+) -> Tensor<FloatType> {
+  var rotary = Tensor<FloatType>(.CPU, .NHWC(1, length, 1, configuration.headDimension))
+  for i in 0..<length {
+    for k in 0..<(configuration.headDimension / 2) {
+      let theta =
+        Double(i) / pow(configuration.ropeTheta, Double(k * 2) / Double(configuration.headDimension))
+      rotary[0, i, 0, k * 2] = FloatType(cos(theta))
+      rotary[0, i, 0, k * 2 + 1] = FloatType(sin(theta))
+    }
+  }
+  return rotary
+}
+
+// MARK: - Attention (shared by the language model and the connector)
+
+private struct MingAttentionParts {
+  var toQueries: Model
+  var toKeys: Model
+  var toValues: Model
+  var out: Model
+  var normQ: Model?
+  var normK: Model?
+}
+
+private func MingAttention(
+  prefix: String, width: Int, headDimension k: Int, heads h: Int, keyValueHeads hk: Int,
+  tokenLength t: Int, hasBias: Bool, hasQKNorm: Bool, normEpsilon: Float, isCausal: Bool,
+  usesFlashAttention: Bool, hasMask: Bool
+) -> (parts: MingAttentionParts, model: Model) {
+  let x = Input()
+  let rot = Input()
+  let mask: Input? = hasMask ? Input() : nil
+  let toKeys = Dense(count: k * hk, noBias: !hasBias, name: "\(prefix).k_proj")
+  let toQueries = Dense(count: k * h, noBias: !hasBias, name: "\(prefix).q_proj")
+  let toValues = Dense(count: k * hk, noBias: !hasBias, name: "\(prefix).v_proj")
+  var keys = toKeys(x).reshaped([1, t, hk, k], format: .NHWC)
+  var queries = toQueries(x).reshaped([1, t, h, k], format: .NHWC)
+  var normQ: Model? = nil
+  var normK: Model? = nil
+  if hasQKNorm {
+    let nk = RMSNorm(epsilon: normEpsilon, axis: [3], name: "\(prefix).k_norm")
+    let nq = RMSNorm(epsilon: normEpsilon, axis: [3], name: "\(prefix).q_norm")
+    keys = nk(keys)
+    queries = nq(queries)
+    normK = nk
+    normQ = nq
+  }
+  var values = toValues(x).reshaped([1, t, hk, k], format: .NHWC)
+  // Half of the scale on each side, as Qwen3 does, so the attention scale is 1.
+  queries = (1.0 / Float(k).squareRoot().squareRoot()) * Functional.cmul(left: queries, right: rot)
+  keys = (1.0 / Float(k).squareRoot().squareRoot()) * Functional.cmul(left: keys, right: rot)
+  var out: Model.IO
+  if usesFlashAttention {
+    let attention = ScaledDotProductAttention(
+      scale: 1, isCausal: isCausal, hasAttentionMask: hasMask)
+    if let mask {
+      out = attention(queries, keys, values, mask).reshaped([t, h * k])
+    } else {
+      out = attention(queries, keys, values).reshaped([t, h * k])
+    }
+  } else {
+    values = values.transposed(1, 2)
+    queries = queries.transposed(1, 2)
+    keys = keys.transposed(1, 2)
+    var outs = [Model.IO]()
+    for i in 0..<hk {
+      let query = queries.reshaped(
+        [1, h / hk, t, k], offset: [0, i * (h / hk), 0, 0], strides: [h * t * k, t * k, k, 1]
+      ).contiguous()
+      let key = keys.reshaped(
+        [1, 1, t, k], offset: [0, i, 0, 0], strides: [hk * t * k, t * k, k, 1]
+      ).contiguous()
+      let value = values.reshaped(
+        [1, 1, t, k], offset: [0, i, 0, 0], strides: [hk * t * k, t * k, k, 1]
+      ).contiguous()
+      var dot = Matmul(transposeB: (2, 3))(query, key)
+      if let last = outs.last {
+        dot.add(dependencies: [last])
+      }
+      if let mask {
+        dot = dot + mask
+      }
+      dot = dot.reshaped([(h / hk) * t, t])
+      dot = dot.softmax()
+      dot = dot.reshaped([1, h / hk, t, t])
+      outs.append(dot * value)
+    }
+    out = Concat(axis: 1)(outs).reshaped([1, h, t, k]).transposed(1, 2).reshaped([t, h * k])
+  }
+  let unifyheads = Dense(count: width, noBias: true, name: "\(prefix).out_proj")
+  out = unifyheads(out)
+  let inputs: [Model.IO] = mask.map { [x, rot, $0] } ?? [x, rot]
+  return (
+    MingAttentionParts(
+      toQueries: toQueries, toKeys: toKeys, toValues: toValues, out: unifyheads, normQ: normQ,
+      normK: normK),
+    Model(inputs, [out])
+  )
+}
+
+// MARK: - Language model
+
+/// Token embedding with the learnable queries injected: `x = embedding(tokens) * keep + injected`.
+public func MingLingEmbedding<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type, tokenLength: Int, configuration: MingLingConfiguration = .ming
+) -> (ModelWeightMapper, Model) {
+  let tokens = Input()
+  let keep = Input()
+  let injected = Input()
+  let embedding = Embedding(
+    T.self, vocabularySize: configuration.vocabularySize, embeddingSize: configuration.hiddenSize,
+    name: "tok_embeddings")
+  let out = embedding(tokens).to(.Float32) .* keep.to(.Float32) + injected.to(.Float32)
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    mapping["thinker.embed_tokens.weight"] = [embedding.weight.name]
+    return mapping
+  }
+  return (mapper, Model([tokens, keep, injected], [out]))
+}
+
+/// What the host needs from a layer's attention half.
+public struct MingLingAttentionOutputs {
+  /// Residual stream after attention, FP32 `[T, hidden]`.
+  public static let residual = 0
+  /// The post-attention RMSNorm output, FP32 `[T, hidden]`.
+  public static let normalized = 1
+  /// MoE layers only: router logits of the text gate and of the image gate, FP32 `[T, experts]`.
+  public static let textLogits = 2
+  public static let imageLogits = 3
+}
+
+/// Attention half of layer `layer`. Inputs: residual FP32 `[T, hidden]`, rotary table, causal mask
+/// `[1, 1, T, T]`. Outputs: see `MingLingAttentionOutputs`.
+public func MingLingAttentionHalf<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type, layer: Int, tokenLength: Int, usesFlashAttention: Bool,
+  configuration: MingLingConfiguration = .ming
+) -> (ModelWeightMapper, Model) {
+  let prefix = "layers.\(layer)"
+  let x = Input()
+  let norm1 = RMSNorm(epsilon: configuration.normEpsilon, axis: [1], name: "\(prefix).input_norm")
+  let (parts, attention) = MingAttention(
+    prefix: "\(prefix).attention", width: configuration.hiddenSize,
+    headDimension: configuration.headDimension, heads: configuration.heads,
+    keyValueHeads: configuration.keyValueHeads, tokenLength: tokenLength, hasBias: false,
+    hasQKNorm: true, normEpsilon: configuration.normEpsilon, isCausal: true,
+    usesFlashAttention: usesFlashAttention, hasMask: true)
+  let rot = Input()
+  let mask = Input()
+  var out = norm1(x).to(T.dataType)
+  out = attention(out, rot, mask).to(of: x) + x
+  let norm2 = RMSNorm(
+    epsilon: configuration.normEpsilon, axis: [1], name: "\(prefix).post_attention_norm")
+  let normalized = norm2(out)
+  var outputs: [Model.IO] = [out, normalized]
+  var textGate: Model? = nil
+  var imageGate: Model? = nil
+  if layer >= configuration.denseLayers {
+    let tg = Dense(count: configuration.experts, noBias: true, name: "\(prefix).text_gate")
+    let ig = Dense(count: configuration.experts, noBias: true, name: "\(prefix).image_gate")
+    outputs.append(tg(normalized))
+    outputs.append(ig(normalized))
+    textGate = tg
+    imageGate = ig
+  }
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    let P = "thinker.layers.\(layer)."
+    mapping[P + "input_layernorm.weight"] = [norm1.weight.name]
+    mapping[P + "post_attention_layernorm.weight"] = [norm2.weight.name]
+    // The checkpoint stores q, k and v as one matrix: the converter slices it into the three
+    // keys below. Hugging Face rotates the two halves of the rotary part, the engine rotates
+    // adjacent pairs, so the rotary rows of q, k and their norms are interleaved per head.
+    func rotated(_ name: String, heads: Int) -> ModelWeightElement {
+      ModelWeightElement(
+        [name], interleavedIndices: [0], numberOfHeads: heads,
+        headDimension: configuration.headDimension,
+        interleavedDimension: configuration.rotaryDimension)
+    }
+    mapping[P + "attention.query_key_value.weight#q"] = rotated(
+      parts.toQueries.weight.name, heads: configuration.heads)
+    mapping[P + "attention.query_key_value.weight#k"] = rotated(
+      parts.toKeys.weight.name, heads: configuration.keyValueHeads)
+    mapping[P + "attention.query_key_value.weight#v"] = [parts.toValues.weight.name]
+    mapping[P + "attention.dense.weight"] = [parts.out.weight.name]
+    mapping[P + "attention.q_norm.weight"] = rotated(parts.normQ!.weight.name, heads: 1)
+    mapping[P + "attention.k_norm.weight"] = rotated(parts.normK!.weight.name, heads: 1)
+    if let textGate, let imageGate {
+      mapping[P + "mlp.gate.proj.weight"] = [textGate.weight.name]
+      mapping[P + "mlp.image_gate.proj.weight"] = [imageGate.weight.name]
+    }
+    return mapping
+  }
+  return (mapper, Model([x, rot, mask], outputs))
+}
+
+/// Dense feed-forward of layer 0. Inputs: residual FP32, normalized FP32. Output: residual FP32.
+public func MingLingDenseHalf<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type, layer: Int, configuration: MingLingConfiguration = .ming
+) -> (ModelWeightMapper, Model) {
+  let prefix = "layers.\(layer)"
+  let residual = Input()
+  let normalized = Input()
+  let gate = Dense(
+    count: configuration.denseIntermediateSize, noBias: true, name: "\(prefix).mlp.gate_proj")
+  let up = Dense(
+    count: configuration.denseIntermediateSize, noBias: true, name: "\(prefix).mlp.up_proj")
+  let down = Dense(count: configuration.hiddenSize, noBias: true, name: "\(prefix).mlp.down_proj")
+  let input = normalized.to(T.dataType)
+  let out = residual + down(up(input) .* gate(input).swish()).to(of: residual)
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    let P = "thinker.layers.\(layer).mlp."
+    mapping[P + "gate_proj.weight"] = [gate.weight.name]
+    mapping[P + "up_proj.weight"] = [up.weight.name]
+    mapping[P + "down_proj.weight"] = [down.weight.name]
+    return mapping
+  }
+  return (mapper, Model([residual, normalized], [out]))
+}
+
+/// MoE half of a layer. Inputs: residual FP32 `[T, hidden]`, normalized FP32 `[T, hidden]`, the
+/// logits of the gate each token uses FP32 `[T, experts]`, and the experts the host picked,
+/// Int32 `[T, expertsPerToken]`. Output: residual FP32.
+public func MingLingMoEHalf(
+  layer: Int, tokenLength: Int, configuration: MingLingConfiguration = .ming
+) -> (ModelWeightMapper, Model) {
+  let prefix = "layers.\(layer)"
+  let residual = Input()
+  let normalized = Input()
+  let logits = Input()
+  let selected = Input()
+  let pairs = tokenLength * configuration.expertsPerToken
+  let prepared = MoERouting(
+    kth: configuration.expertsPerToken, weightScale: configuration.routedScalingFactor,
+    normalizationEpsilon: 1e-20, preselected: true, singleInputToken: false, sigmoid: true,
+    name: "\(prefix).routing")(logits, selected, normalized)
+  let experts = SegmentedSwiGLU(
+    segments: configuration.experts, count: configuration.expertIntermediateSize,
+    name: "\(prefix).experts")
+  let hidden = experts(prepared[0], prepared[3], prepared[4], prepared[1].reshaped([pairs, 1]))
+  let down = SegmentedDense(
+    segments: configuration.experts, count: configuration.hiddenSize, noBias: true,
+    name: "\(prefix).experts.down_proj")
+  let routed = Functional.scatterAdd(
+    count: tokenLength, countPerOutput: configuration.expertsPerToken,
+    down(hidden, prepared[3], prepared[4]), index: prepared[2]
+  ).reshaped([tokenLength, configuration.hiddenSize])
+  let shared = SwiGLU(count: configuration.expertIntermediateSize, name: "\(prefix).shared")
+  let sharedDown = Dense(
+    count: configuration.hiddenSize, noBias: true, name: "\(prefix).shared.down_proj")
+  let out = residual + routed + sharedDown(shared(normalized))
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    let P = "thinker.layers.\(layer).mlp."
+    // The checkpoint stacks the experts: gate_up_proj [experts, 2 * intermediate, hidden] is
+    // [gate; up], down_proj [experts, hidden, intermediate]. The converter writes the stacks.
+    mapping[P + "experts.gate_up_proj.weight#gate"] = [experts.parameters(for: .index(0)).name]
+    mapping[P + "experts.gate_up_proj.weight#up"] = [experts.parameters(for: .index(1)).name]
+    mapping[P + "experts.down_proj.weight"] = [down.weight.name]
+    mapping[P + "shared_experts.gate_proj.weight"] = [shared.parameters(for: .index(0)).name]
+    mapping[P + "shared_experts.up_proj.weight"] = [shared.parameters(for: .index(1)).name]
+    mapping[P + "shared_experts.down_proj.weight"] = [sharedDown.weight.name]
+    return mapping
+  }
+  return (mapper, Model([residual, normalized, logits, selected], [out]))
+}
+
+/// Final RMSNorm of the language model. Input: residual FP32. Output: normalized, FP32.
+public func MingLingFinalNorm(configuration: MingLingConfiguration = .ming) -> (
+  ModelWeightMapper, Model
+) {
+  let x = Input()
+  let norm = RMSNorm(epsilon: configuration.normEpsilon, axis: [1], name: "norm")
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    mapping["thinker.norm.weight"] = [norm.weight.name]
+    return mapping
+  }
+  return (mapper, Model([x], [norm(x)]))
+}
+
+/// Chooses the experts BailingMoeV2 picks: the 4 best groups of 32 by the sum of their two best
+/// scores (`sigmoid(logit) + bias`), then the 8 best experts in those groups. Returns, per token,
+/// the expert ids.
+public func MingLingSelectExperts(
+  scoresWithBias: [Float], tokenLength: Int, configuration: MingLingConfiguration = .ming
+) -> [Int32] {
+  let experts = configuration.experts
+  let groupSize = experts / configuration.expertGroups
+  var result = [Int32]()
+  result.reserveCapacity(tokenLength * configuration.expertsPerToken)
+  for token in 0..<tokenLength {
+    let row = Array(scoresWithBias[(token * experts)..<((token + 1) * experts)])
+    var groupScores = [(score: Float, group: Int)]()
+    for group in 0..<configuration.expertGroups {
+      let slice = row[(group * groupSize)..<((group + 1) * groupSize)].sorted(by: >)
+      groupScores.append((slice[0] + slice[1], group))
+    }
+    let chosen = Set(
+      groupScores.sorted { $0.score > $1.score }.prefix(configuration.selectedGroups).map(\.group))
+    var candidates = [(score: Float, expert: Int)]()
+    for group in chosen {
+      for e in (group * groupSize)..<((group + 1) * groupSize) {
+        candidates.append((row[e], e))
+      }
+    }
+    candidates.sort { $0.score > $1.score }
+    for c in candidates.prefix(configuration.expertsPerToken) {
+      result.append(Int32(c.expert))
+    }
+  }
+  return result
+}
+
+// MARK: - Connector and projections
+
+/// `proj_in` (2048 → 1536), the Qwen2 connector with attention in both directions, its final norm
+/// and `proj_out` (1536 → 2560), over the language model's 256 query outputs. Inputs: queries
+/// `[256, 2048]`, rotary table `[1, 256, 1, 128]`. Output: `[256, 2560]`.
+public func MingConnector<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type, tokenLength: Int, usesFlashAttention: Bool,
+  configuration c: MingConnectorConfiguration = .ming
+) -> (ModelWeightMapper, Model) {
+  let x = Input()
+  let rot = Input()
+  let projIn = Dense(count: c.hiddenSize, name: "proj_in")
+  var out = projIn(x).to(.Float32)
+  var mappers = [ModelWeightMapper]()
+  for i in 0..<c.layers {
+    let prefix = "connector.layers.\(i)"
+    let norm1 = RMSNorm(epsilon: c.normEpsilon, axis: [1], name: "\(prefix).input_norm")
+    let (parts, attention) = MingAttention(
+      prefix: "\(prefix).self_attn", width: c.hiddenSize, headDimension: c.headDimension,
+      heads: c.heads, keyValueHeads: c.keyValueHeads, tokenLength: tokenLength, hasBias: true,
+      hasQKNorm: false, normEpsilon: c.normEpsilon, isCausal: false,
+      usesFlashAttention: usesFlashAttention, hasMask: false)
+    let residual = out
+    out = attention(norm1(out).to(T.dataType), rot).to(of: residual) + residual
+    let norm2 = RMSNorm(epsilon: c.normEpsilon, axis: [1], name: "\(prefix).post_attention_norm")
+    let gate = Dense(count: c.intermediateSize, noBias: true, name: "\(prefix).mlp.gate_proj")
+    let up = Dense(count: c.intermediateSize, noBias: true, name: "\(prefix).mlp.up_proj")
+    let down = Dense(count: c.hiddenSize, noBias: true, name: "\(prefix).mlp.down_proj")
+    let input = norm2(out).to(T.dataType)
+    out = out + down(up(input) .* gate(input).swish()).to(of: out)
+    mappers.append { _ in
+      var mapping = ModelWeightMapping()
+      let P = "\(prefix)."
+      func rotated(_ name: String, heads: Int) -> ModelWeightElement {
+        ModelWeightElement(
+          [name], interleavedIndices: [0], numberOfHeads: heads, headDimension: c.headDimension)
+      }
+      mapping[P + "input_layernorm.weight"] = [norm1.weight.name]
+      mapping[P + "post_attention_layernorm.weight"] = [norm2.weight.name]
+      mapping[P + "self_attn.q_proj.weight"] = rotated(parts.toQueries.weight.name, heads: c.heads)
+      mapping[P + "self_attn.q_proj.bias"] = rotated(
+        parts.toQueries.bias.name, heads: c.heads)
+      mapping[P + "self_attn.k_proj.weight"] = rotated(
+        parts.toKeys.weight.name, heads: c.keyValueHeads)
+      mapping[P + "self_attn.k_proj.bias"] = rotated(parts.toKeys.bias.name, heads: c.keyValueHeads)
+      mapping[P + "self_attn.v_proj.weight"] = [parts.toValues.weight.name]
+      mapping[P + "self_attn.v_proj.bias"] = [parts.toValues.bias.name]
+      mapping[P + "self_attn.o_proj.weight"] = [parts.out.weight.name]
+      mapping[P + "mlp.gate_proj.weight"] = [gate.weight.name]
+      mapping[P + "mlp.up_proj.weight"] = [up.weight.name]
+      mapping[P + "mlp.down_proj.weight"] = [down.weight.name]
+      return mapping
+    }
+  }
+  let finalNorm = RMSNorm(epsilon: c.normEpsilon, axis: [1], name: "connector.norm")
+  let projOut = Dense(count: c.outputSize, name: "proj_out")
+  let result = projOut(finalNorm(out).to(T.dataType))
+  let mapper: ModelWeightMapper = { format in
+    var mapping = ModelWeightMapping()
+    mapping["proj_in.weight"] = [projIn.weight.name]
+    mapping["proj_in.bias"] = [projIn.bias.name]
+    mapping["connector.norm.weight"] = [finalNorm.weight.name]
+    mapping["proj_out.weight"] = [projOut.weight.name]
+    mapping["proj_out.bias"] = [projOut.bias.name]
+    for layerMapper in mappers {
+      mapping.merge(layerMapper(format)) { first, _ in first }
+    }
+    return mapping
+  }
+  return (mapper, Model([x, rot], [result]))
+}
+
+/// The second caption stream: the language model's hidden states after layers 5, 12 and 20 over
+/// the prompt tokens, concatenated (3 × 2048), RMS-normalized (1e-5) and projected to 3840.
+public func MingDirectVLMProjection<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type
+) -> (ModelWeightMapper, Model) {
+  let x = Input()
+  let norm = RMSNorm(epsilon: 1e-5, axis: [1], name: "proj_directvlm.norm")
+  let linear = Dense(count: 3_840, name: "proj_directvlm.linear")
+  let out = linear(norm(x).to(T.dataType))
+  let mapper: ModelWeightMapper = { _ in
+    var mapping = ModelWeightMapping()
+    mapping["proj_directvlm.0.weight"] = [norm.weight.name]
+    mapping["proj_directvlm.1.weight"] = [linear.weight.name]
+    mapping["proj_directvlm.1.bias"] = [linear.bias.name]
+    return mapping
+  }
+  return (mapper, Model([x], [out]))
+}
+
+// MARK: - VAE
+
+/// Ming-Image's VAE is the Wan 2.1 / Qwen-Image VAE (`AutoencoderKLQwenImage`: 96 base channels,
+/// multipliers [1, 2, 4, 4], two residual blocks, 16 latent channels, scaling factor 8.0064, no
+/// shift) with four colour channels, RGBA, on both ends.
+public func MingVAEDecoder(width: Int, height: Int) -> (ModelWeightMapper, Model) {
+  WanDecoderCausal3D(
+    channels: [96, 192, 384, 384], numRepeat: 2, startWidth: width, startHeight: height,
+    startDepth: 1, paddingFinalConvLayer: true, wan22: false, outputChannels: 4,
+    highPrecisionFinalNorm: true, usesFlashAttention: false, format: .NHWC)
+}
+
+public func MingVAEEncoder(width: Int, height: Int) -> (ModelWeightMapper, Model) {
+  WanEncoderCausal3D(
+    channels: [96, 192, 384, 384], numRepeat: 2, startWidth: width, startHeight: height,
+    startDepth: 1, wan22: false, inputChannels: 4, usesFlashAttention: false, format: .NHWC)
+}
+
+// MARK: - Vision (image editing)
+
+/// Ming-Image's vision tower is Qwen2.5-VL's (32 blocks of 1280, 16 heads, MLP 3456, windows of 8 x 8
+/// patches and full attention in blocks 7, 15, 23 and 31) with a merger that outputs 8192 features.
+/// The patches arrive in the engine's window order, as for Qwen Image Edit's text encoder.
+public func MingVisionTransformer(gridX: Int, gridY: Int, usesFlashAttention: Bool) -> Model {
+  Qwen2VLVisionTransformer(
+    gridX: gridX, gridY: gridY, width: 1_280, layers: 32, fullAttentionLayers: [7, 15, 23, 31],
+    heads: 16, MLP: 3_456, batchSize: 1, usesFlashAttention: usesFlashAttention, outputSize: 8_192)
+}
+
+public func MingVisionRotaryEmbedding<FloatType: TensorNumeric & BinaryFloatingPoint>(
+  gridX: Int, gridY: Int, of dataType: FloatType.Type = FloatType.self
+) -> Tensor<FloatType> {
+  Qwen2VLViTRotaryEmbedding(gridX: gridX, gridY: gridY, of: dataType)
+}
+
+/// `linear_proj` (8192 -> 2048, GELU, 2048 -> 2048) followed by the L2 normalization of every row, over
+/// the vision tower's merged features. The result replaces the `<imagePatch>` embeddings.
+public func MingImageProjection<T: TensorNumeric & BinaryFloatingPoint>(
+  _ dataType: T.Type
+) -> Model {
+  let x = Input()
+  let first = Dense(count: 2_048, name: "image_proj_0")
+  let second = Dense(count: 2_048, name: "image_proj_2")
+  let projected = second(first(x).GELU()).to(.Float32)
+  // F.normalize(x) = x / ||x||; RMSNorm gives x * sqrt(n) / ||x||.
+  let norm = RMSNorm(epsilon: 1e-12, axis: [1], elementwiseAffine: false, name: "image_proj_norm")
+  return Model([x], [(1 / Float(2_048).squareRoot()) * norm(projected)])
+}
diff --git a/Libraries/SwiftDiffusion/Sources/Models/MingVision.swift b/Libraries/SwiftDiffusion/Sources/Models/MingVision.swift
new file mode 100644
index 0000000..0ac3cbb
--- /dev/null
+++ b/Libraries/SwiftDiffusion/Sources/Models/MingVision.swift
@@ -0,0 +1,228 @@
+import Foundation
+import NNC
+
+#if canImport(C_ccv)
+  import C_ccv
+#endif
+#if canImport(C_swiftpm_ccv)
+  import C_swiftpm_ccv
+#endif
+
+// The vision-side data handling of Ming-Image's image editing: the picture goes through the Qwen2.5-VL
+// preprocessing (resize to multiples of 28, the normalization, 14 x 14 patches of two frames in the
+// engine's window order) and the merged tokens come back in reading order. Both are the code Qwen
+// Image Edit's text encoder runs inline (TextEncoder.swift), copied here so that one does not change.
+
+/// Resizes `image` (`[1, h, w, 3]`, -1...1) to Ming's vision input, about 672 x 672 pixels in
+/// multiples of 28 (`min_pixels = max_pixels = 451584`), normalizes it with the CLIP mean and
+/// standard deviation, and orders its patches for `MingVisionTransformer`.
+public func MingVisionPatches(
+  image: DynamicGraph.Tensor<FloatType>, graph: DynamicGraph
+) -> (patches: DynamicGraph.Tensor<FloatType>, gridX: Int, gridY: Int) {
+  let mean = graph.variable(
+    Tensor<FloatType>(
+      [
+        FloatType(2 * 0.48145466 - 1), FloatType(2 * 0.4578275 - 1), FloatType(2 * 0.40821073 - 1),
+      ], .GPU(0), .NHWC(1, 1, 1, 3)))
+  let invStd = graph.variable(
+    Tensor<FloatType>(
+      [FloatType(0.5 / 0.26862954), FloatType(0.5 / 0.26130258), FloatType(0.5 / 0.27577711)],
+      .GPU(0), .NHWC(1, 1, 1, 3)))
+  var input = (image.toGPU(0) - mean) .* invStd
+  let shape = input.shape
+  let height = shape[1]
+  let width = shape[2]
+  // smart_resize with min_pixels = max_pixels = 451584 and factor 28.
+  let maxPixels = 451_584.0
+  var hBar = (Double(height) / 28).rounded() * 28
+  var wBar = (Double(width) / 28).rounded() * 28
+  if hBar * wBar > maxPixels {
+    let beta = (Double(height * width) / maxPixels).squareRoot()
+    hBar = max(28, (Double(height) / beta / 28).rounded(.down) * 28)
+    wBar = max(28, (Double(width) / beta / 28).rounded(.down) * 28)
+  } else if hBar * wBar < maxPixels {
+    let beta = (maxPixels / Double(height * width)).squareRoot()
+    hBar = (Double(height) * beta / 28).rounded(.up) * 28
+    wBar = (Double(width) * beta / 28).rounded(.up) * 28
+  }
+  let targetHeight = Int(hBar)
+  let targetWidth = Int(wBar)
+  if shape[1] != targetHeight || shape[2] != targetWidth {
+    // Use high-quality resize operation.
+    let f32 = Tensor<Float>(
+      from: input.rawValue.toCPU().reshaped(.HWC(shape[1], shape[2], shape[3])))
+    var b: UnsafeMutablePointer<ccv_dense_matrix_t>? = ccv_dense_matrix_new(
+      Int32(targetHeight), Int32(targetWidth), Int32(CCV_C3 | CCV_32F), nil, 0)
+    ccv_resample(
+      UnsafeMutableRawPointer(f32.cTensor).assumingMemoryBound(to: ccv_dense_matrix_t.self),
+      &b, 0, hBar / Double(shape[1]), wBar / Double(shape[2]),
+      Int32(CCV_INTER_AREA | CCV_INTER_CUBIC)
+    )
+    input = graph.variable(
+      Tensor<FloatType>(
+        from: Tensor<Float>(
+          .CPU, format: .NHWC, shape: [1, targetHeight, targetWidth, 3],
+          unsafeMutablePointer: b!.pointee.data.f32, bindLifetimeOf: b!
+        ).copied()
+      ).toGPU(0))
+    ccv_matrix_free(b)
+  }
+  // Input is in h, w, 3 format, the expected format for QwenVL is complicated, let's break it down step-by-step:
+  // 1. reformat to NCHW: 1, 3, h, w.
+  // 2. move it into 14x14 patch: 1, 3, h / 14, 14, w / 14, 14, then move it to: h / 14, w / 14, 3, 14, 14
+  // 3. making it two frames: h / 14, w / 14, 3, 2, 14, 14
+  // 4. coordinating with the rotary encoding, but move it further into compact 2x2 blocks: h / 28, 2, w / 28, 2, 3, 2, 14, 14 -> h / 28, w / 28, 2, 2, 3, 2, 14, 14
+  // 5. (optional) doing additional work to make sure it is a further 8x8 patch (112x112 in pixel space) for windowed attention.
+  input = input.permuted(0, 3, 1, 2).copied().reshaped(
+    format: .NHWC, shape: [3, targetHeight / 14, 14, targetWidth / 14, 14]
+  ).permuted(1, 3, 0, 2, 4).copied().reshaped(
+    .NHWC((targetHeight / 14) * (targetWidth / 14), 3, 14, 14))
+  input = Functional.concat(axis: 2, input, input).reshaped(
+    format: .NHWC, shape: [targetHeight / 28, 2, targetWidth / 28, 2, 3 * 2 * 14 * 14]
+  ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+    .HWC(targetHeight / 28, targetWidth / 28, 4 * 3 * 2 * 14 * 14))
+  // Step 4 is done, now doing step 5, copying it over to a 8x8 patch (in this case, 4x4 patch because already clustered to 2x2 patch).
+  let gridX = targetWidth / 14
+  let gridY = targetHeight / 14
+  if gridX % 8 == 0, gridY % 8 == 0 {
+    // Can directly permuted into the patch required.
+    input = input.reshaped(
+      format: .NHWC, shape: [gridY / 8, 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(.WC(gridY * gridX, 3 * 2 * 14 * 14))
+  } else if gridX % 8 == 0 {
+    let shape = input.shape
+    let top = input[0..<((gridY / 8) * 4), 0..<shape[1], 0..<shape[2]].copied().reshaped(
+      format: .NHWC, shape: [gridY / 8, 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .WC((gridY / 8) * 8 * gridX, 3 * 2 * 14 * 14))
+    let bottom = input[((gridY / 8) * 4)..<shape[0], 0..<shape[1], 0..<shape[2]].copied()
+      .reshaped(
+        format: .NHWC, shape: [1, (gridY / 2) % 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14]
+      )
+      .permuted(0, 2, 1, 3, 4).copied().reshaped(.WC((gridY % 8) * gridX, 3 * 2 * 14 * 14))
+    input = Functional.concat(axis: 0, top, bottom)
+  } else if gridY % 8 == 0 {
+    let shape = input.shape
+    let left = input[0..<shape[0], 0..<((gridX / 8) * 4), 0..<shape[2]].copied().reshaped(
+      format: .NHWC, shape: [gridY / 8, 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .WC(gridY * (gridX / 8) * 8, 3 * 2 * 14 * 14))
+    let right = input[0..<shape[0], ((gridX / 8) * 4)..<shape[1], 0..<shape[2]].copied()
+      .reshaped(
+        format: .NHWC, shape: [gridY / 8, 4, 1, (gridX / 2) % 4, 4 * 3 * 2 * 14 * 14]
+      )
+      .permuted(0, 2, 1, 3, 4).copied().reshaped(.WC(gridY * (gridX % 8), 3 * 2 * 14 * 14))
+    input = Functional.concat(axis: 0, left, right)
+  } else {
+    let shape = input.shape
+    let topLeft = input[0..<((gridY / 8) * 4), 0..<((gridX / 8) * 4), 0..<shape[2]].copied()
+      .reshaped(format: .NHWC, shape: [gridY / 8, 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14])
+      .permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .WC((gridY / 8) * 8 * (gridX / 8) * 8, 3 * 2 * 14 * 14))
+    let right = input[0..<((gridY / 8) * 4), ((gridX / 8) * 4)..<shape[1], 0..<shape[2]]
+      .copied().reshaped(
+        format: .NHWC, shape: [gridY / 8, 4, 1, (gridX / 2) % 4, 4 * 3 * 2 * 14 * 14]
+      ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .WC((gridY / 8) * 8 * (gridX % 8), 3 * 2 * 14 * 14))
+    let bottom = input[((gridY / 8) * 4)..<shape[0], 0..<((gridX / 8) * 4), 0..<shape[2]]
+      .copied().reshaped(
+        format: .NHWC, shape: [1, (gridY / 2) % 4, gridX / 8, 4, 4 * 3 * 2 * 14 * 14]
+      ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .WC((gridY % 8) * (gridX / 8) * 8, 3 * 2 * 14 * 14))
+    let bottomRight = input[
+      ((gridY / 8) * 4)..<shape[0], ((gridX / 8) * 4)..<shape[1], 0..<shape[2]
+    ].copied().reshaped(
+      format: .NHWC, shape: [1, (gridY / 2) % 4, 1, (gridX / 2) % 4, 4 * 3 * 2 * 14 * 14]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .WC((gridY % 8) * (gridX % 8), 3 * 2 * 14 * 14))
+    input = Functional.concat(axis: 0, topLeft, right, bottom, bottomRight)
+  }
+  return (input, gridX, gridY)
+}
+
+/// Puts the merged tokens (`[gridX * gridY / 4, features]` in window order) back in reading order.
+public func MingVisionUnshuffle(
+  _ merged: DynamicGraph.Tensor<FloatType>, gridX: Int, gridY: Int, graph: DynamicGraph
+) -> DynamicGraph.Tensor<FloatType> {
+  var c = merged
+  let resultShape = c.shape
+  if gridX % 8 == 0, gridY % 8 == 0 {
+    // Can directly permuted into the patch required.
+    c = c.reshaped(
+      format: .NHWC, shape: [gridY / 8, gridX / 8, 4, 4, resultShape[1]]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .WC((gridY / 2) * (gridX / 2), resultShape[1]))
+  } else if gridX % 8 == 0 {
+    let oldC = c
+    c = graph.variable(.GPU(0), .HWC(gridY / 2, gridX / 2, resultShape[1]))
+    let top = oldC[0..<(gridX / 2) * ((gridY / 8) * 4), 0..<resultShape[1]].copied()
+      .reshaped(
+        format: .NHWC, shape: [gridY / 8, gridX / 8, 4, 4, resultShape[1]]
+      ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .HWC((gridY / 8) * 4, gridX / 2, resultShape[1]))
+    let bottom = oldC[
+      ((gridX / 2) * ((gridY / 8) * 4))..<resultShape[0], 0..<resultShape[1]
+    ]
+    .copied()
+    .reshaped(format: .NHWC, shape: [1, gridX / 8, (gridY / 2) % 4, 4, resultShape[1]])
+    .permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .HWC((gridY / 2) % 4, gridX / 2, resultShape[1]))
+    c[0..<((gridY / 8) * 4), 0..<(gridX / 2), 0..<resultShape[1]] = top
+    c[((gridY / 8) * 4)..<(gridY / 2), 0..<(gridX / 2), 0..<resultShape[1]] = bottom
+    c = c.reshaped(.WC((gridY / 2) * (gridX / 2), resultShape[1]))
+  } else if gridY % 8 == 0 {
+    let oldC = c
+    c = graph.variable(.GPU(0), .HWC(gridY / 2, gridX / 2, resultShape[1]))
+    let left = oldC[0..<(gridY / 2) * ((gridX / 8) * 4), 0..<resultShape[1]].copied()
+      .reshaped(
+        format: .NHWC, shape: [gridY / 8, gridX / 8, 4, 4, resultShape[1]]
+      ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .HWC(gridY / 2, (gridX / 8) * 4, resultShape[1]))
+    let right = oldC[((gridY / 2) * ((gridX / 8) * 4))..<resultShape[0], 0..<resultShape[1]]
+      .copied()
+      .reshaped(format: .NHWC, shape: [gridY / 8, 1, 4, (gridX / 2) % 4, resultShape[1]])
+      .permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .HWC(gridY / 2, (gridX / 2) % 4, resultShape[1]))
+    c[0..<(gridY / 2), 0..<((gridX / 8) * 4), 0..<resultShape[1]] = left
+    c[0..<(gridY / 2), ((gridX / 8) * 4)..<(gridX / 2), 0..<resultShape[1]] = right
+    c = c.reshaped(.WC((gridY / 2) * (gridX / 2), resultShape[1]))
+  } else {
+    let oldC = c
+    c = graph.variable(.GPU(0), .HWC(gridY / 2, gridX / 2, resultShape[1]))
+    let topLeft = oldC[0..<(((gridY / 8) * 4) * ((gridX / 8) * 4)), 0..<resultShape[1]]
+      .copied()
+      .reshaped(format: .NHWC, shape: [gridY / 8, gridX / 8, 4, 4, resultShape[1]])
+      .permuted(0, 2, 1, 3, 4).copied().reshaped(
+        .HWC((gridY / 8) * 4, (gridX / 8) * 4, resultShape[1]))
+    let right = oldC[
+      (((gridY / 8) * 4) * ((gridX / 8) * 4))..<(((gridY / 8) * 4) * (gridX / 2)),
+      0..<resultShape[1]
+    ]
+    .copied().reshaped(
+      format: .NHWC, shape: [gridY / 8, 1, 4, (gridX / 2) % 4, resultShape[1]]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .HWC((gridY / 8) * 4, (gridX / 2) % 4, resultShape[1]))
+    let lastCorner = resultShape[0] - ((gridY / 2) % 4) * ((gridX / 2) % 4)
+    let bottom = oldC[
+      (((gridY / 8) * 4) * (gridX / 2))..<lastCorner, 0..<resultShape[1]
+    ]
+    .copied().reshaped(
+      format: .NHWC, shape: [1, gridX / 8, (gridY / 2) % 4, 4, resultShape[1]]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .HWC((gridY / 2) % 4, (gridX / 8) * 4, resultShape[1]))
+    let bottomRight = oldC[
+      lastCorner..<resultShape[0], 0..<resultShape[1]
+    ].copied().reshaped(
+      format: .NHWC, shape: [1, 1, (gridY / 2) % 4, (gridX / 2) % 4, resultShape[1]]
+    ).permuted(0, 2, 1, 3, 4).copied().reshaped(
+      .HWC((gridY / 2) % 4, (gridX / 2) % 4, resultShape[1]))
+    c[0..<((gridY / 8) * 4), 0..<((gridX / 8) * 4), 0..<resultShape[1]] = topLeft
+    c[0..<((gridY / 8) * 4), ((gridX / 8) * 4)..<(gridX / 2), 0..<resultShape[1]] = right
+    c[((gridY / 8) * 4)..<(gridY / 2), 0..<((gridX / 8) * 4), 0..<resultShape[1]] = bottom
+    c[
+      ((gridY / 8) * 4)..<(gridY / 2), ((gridX / 8) * 4)..<(gridX / 2), 0..<resultShape[1]] =
+      bottomRight
+    c = c.reshaped(.WC((gridY / 2) * (gridX / 2), resultShape[1]))
+  }
+  return c
+}
