+            } else {
+              $0.write(key, tensor: fp16, codec: .ezm7)
+            }
+          case .ltx2, .ltx2_3, .longcatVideoAvatar1_5, .minimaxH3:
+            fatalError()
+          case .mossImage:
+            if tensor.dataType == .Float32 {
+              // time_embedder_2 is kept in FP32 to avoid FP16 underflow.
+              $0.write(key, tensor: tensor)
+            } else if key.contains("embedder") || key.contains("final_linear") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .minimaxH3Image:
+            // As Draw Things' own minimax_h3_*_i8x.ckpt files (and Atelier) store them: block
+            // linears row-wise 8-bit, AdaLN matrices palettized (kept FP16 when small), the token
+            // refiner, embedders and output projections FP16, vectors ezm7, FP32 as they are.
+            let isSmallAdaLN =
+              (key.contains("adaln") || key.contains("norm_out")) && shape.reduce(1, *) < 1 << 20
+            let keepsFP16 =
+              ["refiner", "embedder", "proj_out"].contains { key.contains($0) } || isSmallAdaLN
+            if tensor.dataType == .Float32 {
+              $0.write(key, tensor: tensor)
+            } else if keepsFP16 {
+              $0.write(key, tensor: fp16)
+            } else if squeezedDims > 1 {
+              $0.write(
+                key, tensor: fp16, codec: key.contains("adaln") ? [.q8p, .ezm7] : [.i8x, .ezm7])
+            } else {
+              $0.write(key, tensor: fp16, codec: .ezm7)
+            }
+          case .fibo2:
+            // Embedders, the final projection, gist queries and gates stay in FP16.
+            if key.contains("embedder") || key.contains("final_linear")
+              || key.contains("latent_queries") || key.contains("cross_attn_gate")
+            {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .flux3_5b:
+            if tensor.dataType == .Float32 {
+              // These projections are kept in FP32 to avoid FP16 underflow.
+              $0.write(key, tensor: tensor)
+            } else if key.contains("embedder") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .flux2, .flux2_9b, .flux2_4b, .ideogram4:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
