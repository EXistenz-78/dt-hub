index 0000000..ff86683
--- /dev/null
+++ b/Apps/MingEncoderTest/main.swift
@@ -0,0 +1,336 @@
+import Diffusion
+import Foundation
+import NNC
+import Tokenizer
+
+// Runs Ming-Image's Ling language model layer by layer from the converted checkpoint and compares
+// each layer's output with the PyTorch reference (Tools/ming-reference/ref_encoder.py in DT Hub).
+//
+// Usage: MingEncoderTest <reference.safetensors> <ming_image_ling_mini_2.0_f16.ckpt> [layers]
+
+typealias Half = Float16
+
+let arguments = CommandLine.arguments
+guard arguments.count >= 3 else {
+  print("Usage: MingEncoderTest <reference.safetensors> <encoder.ckpt> [layers]")
+  exit(2)
+}
+let layerLimit = arguments.count > 3 ? Int(arguments[3])! : 20
+let configuration = MingLingConfiguration.ming
+
+guard let reference = SafeTensors(url: URL(fileURLWithPath: arguments[1])) else {
+  fatalError("Cannot open \(arguments[1])")
+}
+func referenceTensor(_ name: String) -> Tensor<Float> {
+  guard let descriptor = reference.states[name] else { fatalError("No \(name) in the reference") }
+  return try! reference.with(descriptor) { Tensor<Float>(from: $0).toCPU() }
+}
+
+let checkpoint = arguments[2]
+let graph = DynamicGraph()
+let codec: DynamicGraph.Store.Codec = [.ezm7, .q8p, .q6p, .q4p, .i8x, .jit, .externalData]
+
+func read(_ model: Model, _ label: String, key: String = "ming_text", path: String? = nil) {
+  graph.openStore(path ?? checkpoint, flags: .readOnly) { store in
+    do {
+      try store.read(key, model: model, strict: true, codec: codec)
+    } catch {
+      print("  ! reading \(label): \(error)")
+    }
+  }
+}
+
+func compare(_ label: String, _ value: Tensor<Float>, _ expected: Tensor<Float>) {
+  let rows = expected.shape[0]
+  let columns = expected.shape.count > 1 ? expected.shape[1] : 1
+  precondition(value.shape[0] == rows, "\(label): \(value.shape) vs \(expected.shape)")
+  var maxDifference: Float = 0
+  var squares = 0.0
+  var expectedSquares = 0.0
+  var worst = (0, 0)
+  for i in 0..<rows {
+    for j in 0..<columns {
+      let a = expected.shape.count > 1 ? value[i, j] : value[i]
+      let b = expected.shape.count > 1 ? expected[i, j] : expected[i]
+      let d = abs(a - b)
+      if d > maxDifference {
+        maxDifference = d
+        worst = (i, j)
+      }
+      squares += Double(d * d)
+      expectedSquares += Double(b * b)
+    }
+  }
+  let relative = (squares / max(expectedSquares, 1e-30)).squareRoot()
+  let status = relative < 2e-2 ? "ok " : "BAD"
+  print(
+    "\(status) \(label): relative error \(String(format: "%.5f", relative)), max |diff| \(maxDifference) at \(worst)"
+  )
+}
+
+if ProcessInfo.processInfo.environment["MING_VISION"] != nil {
+  // arguments[1] = ref_vision.safetensors, arguments[2] = the vision checkpoint.
+  let img = referenceTensor("image")  // [H, W, 3], -1...1
+  let h = img.shape[0]
+  let w = img.shape[1]
+  var half = Tensor<Half>(.CPU, .NHWC(1, h, w, 3))
+  for y in 0..<h { for x in 0..<w { for c in 0..<3 { half[0, y, x, c] = Half(img[y, x, c]) } } }
+  try graph.withNoGrad {
+    let (patches, gridX, gridY) = MingVisionPatches(image: graph.variable(half.toGPU(0)), graph: graph)
+    print("patches \(patches.shape), grid \(gridX) x \(gridY)")
+    let useFloat32 = ProcessInfo.processInfo.environment["MING_VIT_F16"] == nil
+    let vit = MingVisionTransformer(gridX: gridX, gridY: gridY, usesFlashAttention: !useFloat32)
+    var ordered: DynamicGraph.Tensor<Half>
+    if useFloat32 {
+      let patches32 = DynamicGraph.Tensor<Float>(from: patches)
+      let rot = graph.variable(MingVisionRotaryEmbedding(gridX: gridX, gridY: gridY, of: Float.self).toGPU(0))
+      vit.compile(inputs: patches32, rot)
+      read(vit, "vit", key: "vit", path: checkpoint)
+      let merged = vit(inputs: patches32, rot)[0].as(of: Float.self)
+      ordered = MingVisionUnshuffle(DynamicGraph.Tensor<Half>(from: merged), gridX: gridX, gridY: gridY, graph: graph)
+    } else {
+      let rot = graph.variable(MingVisionRotaryEmbedding(gridX: gridX, gridY: gridY, of: Half.self).toGPU(0))
+      vit.compile(inputs: patches, rot)
+      read(vit, "vit", key: "vit", path: checkpoint)
+      let merged = vit(inputs: patches, rot)[0].as(of: Half.self)
+      ordered = MingVisionUnshuffle(merged, gridX: gridX, gridY: gridY, graph: graph)
+    }
+    let orderedCPU = Tensor<Float>(from: ordered.rawValue.toCPU())
+    if let dump = ProcessInfo.processInfo.environment["MING_DUMP"] {
+      var bytes = [Float]()
+      for i in 0..<orderedCPU.shape[0] { for j in 0..<orderedCPU.shape[1] { bytes.append(orderedCPU[i, j]) } }
+      try! bytes.withUnsafeBufferPointer { try Data(buffer: $0).write(to: URL(fileURLWithPath: dump)) }
+    }
+    compare("vision tower", orderedCPU, referenceTensor("vit"))
+    let projection = MingImageProjection(Half.self)
+    projection.compile(inputs: ordered)
+    read(projection, "image projection", key: "vit", path: checkpoint)
+    let features = projection(inputs: ordered)[0].as(of: Float.self)
+    compare("linear_proj + normalize", features.rawValue.toCPU(), referenceTensor("features"))
+  }
+  exit(0)
+}
+if ProcessInfo.processInfo.environment["MING_VITNAMES"] != nil {
+  let vit = MingVisionTransformer(gridX: 8, gridY: 8, usesFlashAttention: true)
+  let patches = graph.variable(.GPU(0), .WC(64, 1_176), of: Half.self)
+  let rot = graph.variable(MingVisionRotaryEmbedding(gridX: 8, gridY: 8, of: Half.self).toGPU(0))
+  vit.compile(inputs: patches, rot)
+  let count = vit.parameters.count
+  print("ViT parameters: \(count)")
+  for i in 0..<count {
+    let name = vit.parameters(for: .index(i)).name
+    if i < 24 || i >= count - 12 { print(name) }
+  }
+  let projection = MingImageProjection(Half.self)
+  projection.compile(inputs: graph.variable(.GPU(0), .WC(4, 8_192), of: Half.self))
+  for i in 0..<projection.parameters.count { print(projection.parameters(for: .index(i)).name) }
+  exit(0)
+}
+// Reference inputs.
+let idsReference = referenceTensor("ids")
+let tokenLength = idsReference.shape[0]
+let ids = (0..<tokenLength).map { Int32(idsReference[$0]) }
+let positionsReference = referenceTensor("positions")
+let positions = (0..<3).map { row in (0..<tokenLength).map { Int(positionsReference[row, $0]) } }
+let patchToken: Int32 = 157_157
+let isPatch = ids.map { $0 == patchToken }
+if let tokenizerPath = ProcessInfo.processInfo.environment["MING_TOKENIZER"] {
+  // Tokenize the same chat text with the engine's tokenizer and compare the ids.
+  let tokenizer = try! TiktokenTokenizer(
+    huggingFaceTokenizerJSON: Data(contentsOf: URL(fileURLWithPath: tokenizerPath)),
+    pretokenizer: .ling, unknownToken: "<|endoftext|>", startToken: "<|endoftext|>",
+    endToken: "<|role_end|>")
+  let prompt = ProcessInfo.processInfo.environment["MING_PROMPT"] ?? "A red apple on a white table"
+  let text =
+    "<role>SYSTEM</role>你是一个友好的AI助手。\n\ndetailed thinking off<|role_end|><role>HUMAN</role>\(prompt)<|role_end|><role>ASSISTANT</role><image>"
+    + String(repeating: "<imagePatch>", count: 256) + "</image>"
+  let (mine, _) = tokenizer.tokenize(text: text, addSpecialTokens: false)
+  if ProcessInfo.processInfo.environment["MING_PRINT_IDS"] != nil {
+    print(mine.map { String($0) }.joined(separator: ","))
+    exit(0)
+  }
+  let same = mine.map { Int32($0) } == ids
+  print("tokenizer: \(mine.count) ids vs \(ids.count) in the reference, \(same ? "identical" : "DIFFERENT")")
+  if !same {
+    for i in 0..<min(mine.count, ids.count) where mine[i] != ids[i] {
+      print("  first difference at \(i): \(mine[i]) vs \(ids[i])")
+      break
+    }
+  }
+  exit(0)
+}
+print("Tokens: \(tokenLength), query tokens: \(isPatch.filter { $0 }.count)")
+
+try graph.withNoGrad {
+  // Embedding, with the learnable queries in the patch rows.
+  var queries: Tensor<Float>? = nil
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    if let tensor = store.read("query_tokens") {
+      queries = Tensor<Float>(from: tensor).toCPU()
+    }
+  }
+  guard let queries else { fatalError("query_tokens is missing from the checkpoint") }
+  var keep = Tensor<Float>(.CPU, .WC(tokenLength, 1))
+  var injected = Tensor<Float>(.CPU, .WC(tokenLength, configuration.hiddenSize))
+  // The picture's features go in the first run of <imagePatch> tokens, the learnable queries in the last 256.
+  let patchIndices = (0..<tokenLength).filter { isPatch[$0] }
+  let imageCount = patchIndices.count - 256
+  var imageFeatures: Tensor<Float>? = nil
+  if let path = ProcessInfo.processInfo.environment["MING_IMAGE_FEATURES"] {
+    let featuresFile = SafeTensors(url: URL(fileURLWithPath: path))!
+    imageFeatures = try! featuresFile.with(featuresFile.states["features"]!) { Tensor<Float>(from: $0).toCPU() }
+    precondition(imageFeatures!.shape[0] == imageCount, "features \(imageFeatures!.shape[0]) vs \(imageCount) image tokens")
+  } else {
+    precondition(imageCount == 0, "the prompt has \(imageCount) image tokens: give MING_IMAGE_FEATURES")
+  }
+  for i in 0..<tokenLength { keep[i, 0] = isPatch[i] ? 0 : 1 }
+  for (k, i) in patchIndices.enumerated() {
+    for j in 0..<configuration.hiddenSize {
+      injected[i, j] = k < imageCount ? imageFeatures![k, j] : queries[k - imageCount, j]
+    }
+  }
+  let tokensGPU = graph.variable(Tensor<Int32>(ids, .CPU, .C(tokenLength)).toGPU(0))
+  let (_, embedding) = MingLingEmbedding(Half.self, tokenLength: tokenLength)
+  embedding.compile(
+    inputs: tokensGPU, graph.variable(keep.toGPU(0)), graph.variable(injected.toGPU(0)))
+  read(embedding, "embedding")
+  var x = embedding(inputs: tokensGPU, graph.variable(keep.toGPU(0)), graph.variable(injected.toGPU(0)))[0]
+    .as(of: Float.self)
+  compare("hidden_0 (embedding)", x.rawValue.toCPU(), referenceTensor("hidden_0"))
+
+  let rotary = graph.variable(
+    MingLingRotaryEmbedding(positions: positions, of: Half.self).toGPU(0))
+  var mask = Tensor<Half>(
+    Array(repeating: 0, count: tokenLength * tokenLength), .CPU, .NHWC(1, 1, tokenLength, tokenLength))
+  for row in 0..<(tokenLength - 1) {
+    for column in (row + 1)..<tokenLength {
+      mask[0, 0, row, column] = -Half.greatestFiniteMagnitude
+    }
+  }
+  let maskGPU = graph.variable(mask.toGPU(0))
+
+  var saved = [Int: Tensor<Float>]()
+  for layer in 0..<min(layerLimit, configuration.layers) {
+    let (_, attention) = MingLingAttentionHalf(
+      Half.self, layer: layer, tokenLength: tokenLength, usesFlashAttention: true)
+    attention.compile(inputs: x, rotary, maskGPU)
+    read(attention, "layer \(layer) attention")
+    let halves = attention(inputs: x, rotary, maskGPU).map { $0.as(of: Float.self) }
+    let residual = halves[MingLingAttentionOutputs.residual]
+    let normalized = halves[MingLingAttentionOutputs.normalized]
+    if layer < configuration.denseLayers {
+      let (_, dense) = MingLingDenseHalf(Half.self, layer: layer)
+      dense.compile(inputs: residual, normalized)
+      read(dense, "layer \(layer) dense")
+      x = dense(inputs: residual, normalized)[0].as(of: Float.self)
+    } else {
+      // Routing on the host: the image gate for the query rows, the text gate for the rest.
+      let textLogits = halves[MingLingAttentionOutputs.textLogits].rawValue.toCPU()
+      let imageLogits = halves[MingLingAttentionOutputs.imageLogits].rawValue.toCPU()
+      var textBias = Tensor<Float>(.CPU, .C(configuration.experts))
+      var imageBias = Tensor<Float>(.CPU, .C(configuration.experts))
+      graph.openStore(checkpoint, flags: .readOnly) { store in
+        if let t = store.read("layers.\(layer).gate.expert_bias") {
+          textBias = Tensor<Float>(from: t).toCPU()
+        }
+        if let t = store.read("layers.\(layer).image_gate.expert_bias") {
+          imageBias = Tensor<Float>(from: t).toCPU()
+        }
+      }
+      var chosen = Tensor<Float>(.CPU, .WC(tokenLength, configuration.experts))
+      var scores = [Float](repeating: 0, count: tokenLength * configuration.experts)
+      for i in 0..<tokenLength {
+        for e in 0..<configuration.experts {
+          let logit = isPatch[i] ? imageLogits[i, e] : textLogits[i, e]
+          let bias = isPatch[i] ? imageBias[e] : textBias[e]
+          chosen[i, e] = logit
+          scores[i * configuration.experts + e] = 1 / (1 + exp(-logit)) + bias
+        }
+      }
+      let selected = MingLingSelectExperts(scoresWithBias: scores, tokenLength: tokenLength)
+      if layer == 1 {
+        // Layer 1's routing in the reference: the experts per token, order aside.
+        let expectedIndex = referenceTensor("router_l1_idx")
+        var mismatches = 0
+        for i in 0..<tokenLength {
+          let mine = Set(
+            (0..<configuration.expertsPerToken).map { Int(selected[i * configuration.expertsPerToken + $0]) })
+          let theirs = Set((0..<configuration.expertsPerToken).map { Int(expectedIndex[i, $0]) })
+          if mine != theirs { mismatches += 1 }
+        }
+        print("\(mismatches == 0 ? "ok " : "BAD") layer 1 routing: \(mismatches) tokens differ")
+      }
+      let (_, moe) = MingLingMoEHalf(layer: layer, tokenLength: tokenLength)
+      let logitsGPU = graph.variable(chosen.toGPU(0))
+      let selectedGPU = graph.variable(
+        Tensor<Int32>(selected, .CPU, .WC(tokenLength, configuration.expertsPerToken)).toGPU(0))
+      moe.compile(inputs: residual, normalized, logitsGPU, selectedGPU)
+      read(moe, "layer \(layer) MoE")
+      x = moe(inputs: residual, normalized, logitsGPU, selectedGPU)[0].as(of: Float.self)
+    }
+    if layer + 1 == 5 || layer + 1 == 12 { saved[layer + 1] = x.rawValue.toCPU() }
+    if layer + 1 < configuration.layers {
+      compare("hidden_\(layer + 1) (after layer \(layer))", x.rawValue.toCPU(), referenceTensor("hidden_\(layer + 1)"))
+    }
+  }
+  if layerLimit >= configuration.layers {
+    let (_, norm) = MingLingFinalNorm()
+    norm.compile(inputs: x)
+    read(norm, "final norm")
+    let final = norm(inputs: x)[0].as(of: Float.self)
+    let finalCPU = final.rawValue.toCPU()
+    compare("hidden_20 (final norm)", finalCPU, referenceTensor("hidden_20"))
+    saved[20] = finalCPU
+
+    // Query stream: the 256 query rows -> proj_in -> connector -> proj_out.
+    var queryRowsHalf = Tensor<Half>(.CPU, .WC(256, configuration.hiddenSize))
+    var row = 0
+    for i in patchIndices.suffix(256) {
+      for j in 0..<configuration.hiddenSize { queryRowsHalf[row, j] = Half(finalCPU[i, j]) }
+      row += 1
+    }
+    let (_, connector) = MingConnector(Half.self, tokenLength: 256, usesFlashAttention: true)
+    let queryGPU = graph.variable(queryRowsHalf.toGPU(0))
+    let connectorRotary = graph.variable(
+      MingConnectorRotaryEmbedding(length: 256, of: Half.self).toGPU(0))
+    connector.compile(inputs: queryGPU, connectorRotary)
+    read(connector, "connector")
+    let conditioning = connector(inputs: queryGPU, connectorRotary)[0].as(of: Half.self)
+    compare(
+      "query_embeds (connector)", Tensor<Float>(from: conditioning.rawValue.toCPU()),
+      referenceTensor("query_embeds"))
+
+    // The connector alone, fed with the reference's own final hidden states.
+    let referenceFinal = referenceTensor("hidden_20")
+    var referenceRows = Tensor<Half>(.CPU, .WC(256, configuration.hiddenSize))
+    row = 0
+    for i in patchIndices.suffix(256) {
+      for j in 0..<configuration.hiddenSize { referenceRows[row, j] = Half(referenceFinal[i, j]) }
+      row += 1
+    }
+    let isolated = connector(inputs: graph.variable(referenceRows.toGPU(0)), connectorRotary)[0]
+      .as(of: Half.self)
+    compare(
+      "query_embeds (connector alone, reference input)",
+      Tensor<Float>(from: isolated.rawValue.toCPU()), referenceTensor("query_embeds"))
+
+    // Second stream: layers 5, 12 and 20 over the prompt tokens.
+    let prefixLength = ids.lastIndex(of: 157_158)!
+    var directInput = Tensor<Half>(.CPU, .WC(prefixLength, 3 * configuration.hiddenSize))
+    for (part, layer) in [5, 12, 20].enumerated() {
+      let source = saved[layer]!
+      for i in 0..<prefixLength {
+        for j in 0..<configuration.hiddenSize {
+          directInput[i, part * configuration.hiddenSize + j] = Half(source[i, j])
+        }
+      }
+    }
+    let (_, direct) = MingDirectVLMProjection(Half.self)
+    let directGPU = graph.variable(directInput.toGPU(0))
+    direct.compile(inputs: directGPU)
+    read(direct, "directvlm")
+    let directOutput = direct(inputs: directGPU)[0].as(of: Half.self)
+    compare(
+      "directvlm", Tensor<Float>(from: directOutput.rawValue.toCPU()), referenceTensor("directvlm"))
+  }
+}
diff --git a/Apps/MingVAETest/main.swift b/Apps/MingVAETest/main.swift
new file mode 100644
index 0000000..1001021
--- /dev/null
+++ b/Apps/MingVAETest/main.swift
@@ -0,0 +1,143 @@
+import Diffusion
+import Foundation
+import NNC
+
+// Round trip through Ming-Image's converted VAE: encode a synthetic RGBA picture, decode the
+// latents, and report how well the picture comes back (PSNR per channel).
+//
+// Usage: MingVAETest <ming_image_vae_f16.ckpt> <reference.safetensors>
+// The reference (Tools/ming-reference/ref_vae.py in DT Hub) holds the picture, its latents and
+// their decoding from PyTorch.
+
+typealias Half = Float16
+
+let arguments = CommandLine.arguments
+guard arguments.count >= 2 else {
+  print("Usage: MingVAETest <vae.ckpt> [size]")
+  exit(2)
+}
+let checkpoint = arguments[1]
+guard arguments.count > 2, let reference = SafeTensors(url: URL(fileURLWithPath: arguments[2]))
+else {
+  print("Usage: MingVAETest <vae.ckpt> <reference.safetensors>")
+  exit(2)
+}
+func referenceTensor(_ name: String) -> Tensor<Float> {
+  try! reference.with(reference.states[name]!) { Tensor<Float>(from: $0).toCPU() }
+}
+let referenceImage = referenceTensor("image")
+let size = referenceImage.shape[1]
+let latentSize = size / 8
+let graph = DynamicGraph()
+let codec: DynamicGraph.Store.Codec = [.ezm7, .jit, .externalData]
+
+/// The engine reads a depth-1 VAE's 3D convolutions (conv_in, conv_out and the residual blocks'
+/// two) by keeping only the last temporal tap, the one a causal convolution applies to a single
+/// frame (FirstStage.swift does the same). The other weights are stored as they are.
+func read(_ model: Model, _ key: String) {
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    do {
+      try store.read(key, model: model, strict: true, codec: codec) {
+        name, dataType, format, shape in
+        guard
+          name.hasSuffix("-0]")
+            && (name.hasPrefix("__\(key)__[t-conv_in-") || name.hasPrefix("__\(key)__[t-conv_out-")
+              || name.hasPrefix("__\(key)__[t-resnet_conv1-")
+              || name.hasPrefix("__\(key)__[t-resnet_conv2-"))
+        else { return .continue(name) }
+        guard
+          var tensor = store.read(name, kind: .CPU, codec: codec).map({ Tensor<Half>(from: $0) })
+        else { return .continue(name) }
+        let channels = tensor.shape.reduce(1, *) / (3 * 3 * 3)
+        let outChannels = shape.reduce(1, *) / (3 * 3)
+        tensor = tensor.reshaped(.NCHW(channels, 3, 3, 3))
+        guard channels < outChannels else {
+          return .final(tensor[0..<channels, 2..<3, 0..<3, 0..<3].contiguous())
+        }
+        var padded = Tensor<Half>(
+          Array(repeating: 0, count: outChannels * 3 * 3), .CPU, .NCHW(outChannels, 1, 3, 3))
+        padded[0..<channels, 0..<1, 0..<3, 0..<3] = tensor[0..<channels, 2..<3, 0..<3, 0..<3]
+          .contiguous()
+        return .final(padded)
+      }
+    } catch {
+      print("  ! reading \(key): \(error)")
+    }
+  }
+}
+
+var image = Tensor<Half>(.CPU, .NHWC(1, size, size, 4))
+for y in 0..<size {
+  for x in 0..<size {
+    for c in 0..<4 { image[0, y, x, c] = Half(referenceImage[0, y, x, c]) }
+  }
+}
+
+func relativeError(_ a: Tensor<Float>, _ b: Tensor<Float>, _ shape: [Int]) -> Double {
+  var difference = 0.0
+  var norm = 0.0
+  for y in 0..<shape[0] {
+    for x in 0..<shape[1] {
+      for c in 0..<shape[2] {
+        let d = Double(a[0, y, x, c] - b[0, y, x, c])
+        difference += d * d
+        norm += Double(b[0, y, x, c]) * Double(b[0, y, x, c])
+      }
+    }
+  }
+  return (difference / max(norm, 1e-30)).squareRoot()
+}
+
+try graph.withNoGrad {
+  let (_, encoder) = MingVAEEncoder(width: latentSize, height: latentSize)
+  let input = graph.variable(image.toGPU(0))
+  encoder.compile(inputs: input)
+  read(encoder, "encoder")
+  let encoded = encoder(inputs: input)[0].as(of: Half.self)
+  print("Encoder output: \(encoded.shape)")
+  // The first 16 channels are the mean, the rest the log variance.
+  let mean = encoded[0..<1, 0..<latentSize, 0..<latentSize, 0..<16].copied()
+  let latents = Tensor<Float>(from: mean.rawValue.toCPU())
+  var sum = 0.0
+  var squares = 0.0
+  for y in 0..<latentSize {
+    for x in 0..<latentSize {
+      for c in 0..<16 {
+        let value = Double(latents[0, y, x, c])
+        sum += value
+        squares += value * value
+      }
+    }
+  }
+  let count = Double(latentSize * latentSize * 16)
+  print(
+    "latents vs PyTorch: relative error "
+      + String(format: "%.5f", relativeError(latents, referenceTensor("latents"), [latentSize, latentSize, 16])))
+  print(
+    "Latents: mean \(String(format: "%.3f", sum / count)), std \(String(format: "%.3f", (squares / count - (sum / count) * (sum / count)).squareRoot()))"
+  )
+
+  let (_, decoder) = MingVAEDecoder(width: latentSize, height: latentSize)
+  decoder.compile(inputs: mean)
+  read(decoder, "decoder")
+  let decoded = decoder(inputs: mean)[0].as(of: Half.self)
+  print("Decoder output: \(decoded.shape)")
+  let result = Tensor<Float>(from: decoded.rawValue.toCPU())
+  print(
+    "decoded vs PyTorch: relative error "
+      + String(format: "%.5f", relativeError(result, referenceTensor("decoded"), [size, size, 4])))
+  for (channel, label) in ["red", "green", "blue", "alpha"].enumerated() {
+    var squareError = 0.0
+    for y in 0..<size {
+      for x in 0..<size {
+        // Back to 0...1 as a picture, clamped like the output is.
+        if channel < 3 && Float(image[0, y, x, 3]) <= 0 { continue }  // colour under transparency
+        let expected = (Double(image[0, y, x, channel]) + 1) / 2
+        let actual = min(max((Double(result[0, y, x, channel]) + 1) / 2, 0), 1)
+        squareError += (expected - actual) * (expected - actual)
+      }
+    }
+    let mse = squareError / Double(size * size)  // not divided by the opaque count: see below
+    print("\(label): PSNR \(String(format: "%.1f", 10 * log10(1 / max(mse, 1e-12)))) dB")
+  }
+}
